{
  "name": "departure-aa",
  "version": "0.1.0",
  "private": true,
  "description": "一起分账吧 - 多人场景记账小程序 monorepo",
  "scripts": {
    "dev:admin": "pnpm --filter @departure/admin dev",
    "build:admin": "pnpm --filter @departure/admin build",
    "start:admin": "pnpm --filter @departure/admin start",
    "test:admin": "pnpm --filter @departure/admin test",
    "verify:admin-live": "pnpm --filter @departure/admin verify:live",
    "verify:admin-statistics": "pnpm --filter @departure/admin verify:statistics",
    "verify:admin-production-assets": "pnpm --filter @departure/admin verify:production-assets",
    "admin:hash-password": "pnpm --filter @departure/admin hash-password",
    "dev:server": "pnpm --filter @departure/server start:dev",
    "build:server": "pnpm --filter @departure/server build",
    "build:shared": "pnpm --filter @departure/shared build",
    "dev:shared": "pnpm --filter @departure/shared dev",
    "lint": "pnpm -r lint",
    "gen-asset": "node scripts/gen-asset.js"
  },
  "devDependencies": {
    "@types/multer": "^2.2.0",
    "@types/uuid": "^11.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "@tiptap/extension-blockquote": "2.1.13",
      "@tiptap/extension-bold": "2.1.13",
      "@tiptap/extension-bullet-list": "2.1.13",
      "@tiptap/extension-code-block": "2.1.13",
      "@tiptap/extension-dropcursor": "2.1.13",
      "@tiptap/extension-gapcursor": "2.1.13",
      "@tiptap/extension-hard-break": "2.1.13",
      "@tiptap/extension-history": "2.1.13",
      "@tiptap/extension-horizontal-rule": "2.1.13",
      "@tiptap/extension-italic": "2.1.13",
      "@tiptap/extension-list-item": "2.1.13",
      "@tiptap/extension-ordered-list": "2.1.13",
      "@tiptap/extension-paragraph": "2.1.13",
      "@tiptap/extension-strike": "2.1.13"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1109.0",
    "uuid": "^14.0.1"
  }
}
