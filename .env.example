# 环境变量配置。这里只放占位符，不要提交真实密钥。

# PostgreSQL。非 production 环境固定连接 aa_jizhang_test，忽略 DB_DATABASE。
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_DATABASE=aa_jizhang
DB_SSL=false

# NestJS 服务
PORT=9080
JWT_SECRET=replace-with-a-long-random-secret

# AdminJS 独立只读后台
ADMIN_HOST=127.0.0.1
ADMIN_PORT=9081
ADMIN_EMAIL=admin@example.com
# 使用 `pnpm admin:hash-password` 交互生成 bcrypt 哈希，禁止填写明文密码。
ADMIN_PASSWORD_HASH=
# 至少 32 个字符；可用 `openssl rand -base64 48` 生成。
ADMIN_SESSION_SECRET=
# production 环境必须显式打开，后台才允许连接 DB_DATABASE。
ADMIN_ALLOW_PRODUCTION_DB=false
# 仅在反向代理正确设置 X-Forwarded-* 后配置为 1。
ADMIN_TRUST_PROXY=0
# 单实例默认使用 packages/admin/.sessions；多实例部署应改用共享 session store。
ADMIN_SESSION_DIR=

# 微信小程序
WX_APPID=
WX_SECRET=

# AI 图片生成 API
IMAGE_API_BASE_URL=
IMAGE_API_KEY=
IMAGE_API_MODEL=gpt-image-2

# Cloudflare R2 对象存储
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# 图片上传策略（KB）
IMAGE_UPLOAD_THRESHOLD=200

# OCR 与 AI 总结服务
OCR_API_URL=
OCR_API_KEY=
AI_SUMMARY_BASE_URL=https://api.openai.com/v1
AI_SUMMARY_API_KEY=
AI_SUMMARY_MODEL=gpt-4o-mini
