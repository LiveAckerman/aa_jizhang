.auth-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.auth-drawer {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.drawer-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.drawer-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: rgba(128, 145, 165, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
}

.drawer-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.avatar-picker {
  background: transparent;
  padding: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  line-height: 1.4;
}

.avatar-picker::after { border: none; }

.avatar-preview {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  background: #eee;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.avatar-tip {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
}

.nickname-row {
  width: 100%;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: rgba(64, 151, 169, 0.08);
  border-radius: 20rpx;
  margin-top: 12rpx;
}

.row-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-right: 20rpx;
}

.nickname-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
}

.confirm-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  margin-top: 40rpx;
}
