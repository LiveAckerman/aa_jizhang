.bc-card {
  position: relative;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 64rpx rgba(47, 65, 89, 0.10);
}

/* 列表态：卡片间距 + 可点反馈 */
.bc-list {
  height: 300rpx;
  margin-bottom: 24rpx;
}
.bc-list:active {
  transform: scale(0.985);
  transition: transform 0.12s ease;
}

/* 详情态：与原头图一致高度，顶部留白 */
.bc-detail {
  height: 320rpx;
  margin-top: 24rpx;
}

.bc-cover {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  /* 轻度高斯模糊柔化背景，放大盖住边缘发虚 */
  filter: blur(2rpx);
  transform: scale(1.04);
}

.bc-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(47, 65, 89, 0.15), rgba(47, 65, 89, 0.68));
}

.bc-content {
  position: absolute;
  inset: 0;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.bc-bottom {
  margin-top: auto;
}

/* ---- 顶部 ---- */
.bc-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.bc-members {
  display: flex;
  align-items: center;
}

.bc-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  border: 2rpx solid #fff;
  margin-right: -14rpx;
  background: #eee;
}

/* +N 溢出气泡：与头像同尺寸，白底半透明 */
.bc-extra {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  border: 2rpx solid #fff;
  margin-right: -14rpx;
  background: rgba(255, 255, 255, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 600;
  color: #4097a9;
}

.bc-invite {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
}

.bc-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.bc-share-btn {
  width: 56rpx;
  min-width: 56rpx;
  max-width: 56rpx;
  height: 56rpx;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  flex-shrink: 0;
  border: none;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  font-size: 0;
}
.bc-share-btn::after {
  border: none;
}

/* ---- 底部 ---- */
.bc-bottom {
  display: flex;
  flex-direction: column;
  margin-top: auto;
}

.bc-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.bc-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 420rpx;
}

.bc-badge {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.22);
  font-size: 22rpx;
  color: #fff;
  flex-shrink: 0;
}

.bc-date {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  flex-shrink: 0;
}

.bc-amount-value {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
}

.bc-amount-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
}
