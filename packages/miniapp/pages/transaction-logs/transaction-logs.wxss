.logs-page {
  padding: 24rpx 32rpx;
}

.logs-empty {
  text-align: center;
  color: var(--text-secondary);
  padding: 120rpx 0;
  font-size: 28rpx;
}

.log-item {
  display: flex;
  align-items: flex-start;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}

.log-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: #eee;
  flex-shrink: 0;
}

.log-body {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.log-user {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.log-lines {
  display: flex;
  flex-direction: column;
  margin-top: 8rpx;
}

.log-line {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.log-time {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-left: 16rpx;
  flex-shrink: 0;
}
