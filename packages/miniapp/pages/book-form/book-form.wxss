.form-page {
  padding-bottom: 60rpx;
}

.cover-picker {
  width: 100%;
  height: 280rpx;
  border-radius: 32rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  /* 柔和的浅色渐变 + 虚线描边，替代突兀的米黄纯色 */
  background: linear-gradient(135deg, rgba(64, 151, 169, 0.06), rgba(250, 149, 131, 0.06));
  border: 2rpx dashed rgba(64, 151, 169, 0.3);
  box-sizing: border-box;
}

.cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.cover-tip {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.form-card {
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.form-input {
  font-size: 30rpx;
  color: var(--text-primary);
}

.form-textarea {
  width: 100%;
  height: 140rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

.scene-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.scene-item {
  width: 128rpx;
  height: 128rpx;
  border-radius: 24rpx;
  background: rgba(64, 151, 169, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.scene-item.active {
  background: var(--color-primary);
}

.scene-item.active .scene-name {
  color: #fff;
}

.scene-name {
  font-size: 24rpx;
  color: var(--text-primary);
  margin-top: 12rpx;
}

/* 自定义场景名输入 */
.custom-scene-wrap {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid rgba(128, 145, 165, 0.12);
}

.custom-scene-input {
  height: 80rpx;
  padding: 0 28rpx;
  background: rgba(64, 151, 169, 0.06);
  border-radius: 20rpx;
  font-size: 28rpx;
  color: var(--text-primary);
}

.save-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  margin-top: 24rpx;
}

/* ── 加载骨架屏 ── */
.loading-skeleton {
  padding: 0 32rpx;
}
.sk-cover {
  width: 100%;
  height: 320rpx;
  background: #eef0f3;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  animation: skeleton-loading 1.2s ease-in-out infinite;
}
.sk-card {
  background: rgba(255, 255, 255, 0.85);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.sk-line {
  height: 28rpx;
  background: #eef0f3;
  border-radius: 8rpx;
  animation: skeleton-loading 1.2s ease-in-out infinite;
}
.sk-line-label {
  width: 30%;
  margin-bottom: 24rpx;
}
.sk-line-input {
  width: 80%;
  height: 40rpx;
}
.sk-line-textarea {
  width: 90%;
  height: 120rpx;
}
.sk-scene-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.sk-scene-item {
  width: calc((100% - 32rpx) / 3);
  height: 88rpx;
  background: #eef0f3;
  border-radius: 16rpx;
  animation: skeleton-loading 1.2s ease-in-out infinite;
}
@keyframes skeleton-loading {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}
