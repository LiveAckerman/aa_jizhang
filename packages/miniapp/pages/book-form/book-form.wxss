.form-page {
  padding-bottom: 60rpx;
}

.cover-picker {
  width: 100%;
  height: 280rpx;
  border-radius: 32rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  background: var(--color-secondary);
}

.cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.cover-tip {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.form-card {
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.form-input {
  font-size: 30rpx;
  color: var(--text-primary);
}

.form-textarea {
  width: 100%;
  height: 140rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

.scene-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.scene-item {
  width: 128rpx;
  height: 128rpx;
  border-radius: 24rpx;
  background: rgba(64, 151, 169, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.scene-item.active {
  background: var(--color-primary);
}

.scene-item.active .scene-name {
  color: #fff;
}

.scene-name {
  font-size: 24rpx;
  color: var(--text-primary);
  margin-top: 12rpx;
}

.save-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  margin-top: 24rpx;
}
