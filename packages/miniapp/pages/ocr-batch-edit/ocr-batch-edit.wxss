.ocr-batch-page {
  padding: 24rpx 32rpx calc(160rpx + env(safe-area-inset-bottom));
}

/* 步骤指示器 */
.step-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.step-scroll {
  display: flex;
  gap: 16rpx;
  flex: 1;
  flex-wrap: wrap;
}
.step-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #fff;
  color: var(--text-secondary);
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(47, 65, 89, 0.06);
}
.step-dot.active {
  background: var(--color-primary);
  color: #fff;
}
.step-dot.unchecked {
  opacity: 0.4;
}
.step-count {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-left: 16rpx;
  white-space: nowrap;
}

/* 当前条操作行 */
.record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.record-check {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  background: rgba(128, 145, 165, 0.14);
  font-size: 24rpx;
  color: var(--text-secondary);
}
.record-check.on {
  background: var(--color-primary);
  color: #fff;
}
.record-check-label {
  line-height: 1;
}
.record-del {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: var(--color-accent);
  padding: 10rpx 20rpx;
}

/* 上一条/下一条 */
.pager {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
}
.pager-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  background: #fff;
  color: var(--text-primary);
  font-size: 28rpx;
  border: 2rpx solid rgba(128, 145, 165, 0.2);
}
.pager-btn[disabled] {
  opacity: 0.4;
}
.pager-btn::after { border: none; }

/* 底部确认 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  box-shadow: 0 -8rpx 32rpx rgba(47, 65, 89, 0.08);
}
.submit-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
}

.empty, .loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  gap: 32rpx;
}
.empty-text, .loading text {
  font-size: 28rpx;
  color: var(--text-secondary);
}
.empty-back {
  width: 300rpx;
  height: 88rpx;
  line-height: 88rpx;
}
