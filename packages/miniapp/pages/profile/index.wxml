<view class="profile-page">
  <!-- 游客态：未登录，显示 logo + 引导登录（纵向居中，无箭头） -->
  <view wx:if="{{isGuest}}" class="user-card" bindtap="onGuestLogin">
    <view class="avatar-section">
      <image class="avatar" src="https://cdn.ljw44.com/assets/logo/logo-card.webp" mode="aspectFill" />
    </view>
    <view class="user-info">
      <text class="nickname">点击登录</text>
    </view>
  </view>

  <!-- 用户信息卡片 -->
  <view wx:else class="user-card" bindtap="goEdit">
    <view class="avatar-section">
      <image class="avatar" src="{{user.avatar}}" mode="aspectFill" />
    </view>
    <view class="user-info">
      <text class="nickname">{{user.nickname}}</text>
    </view>
  </view>

  <!-- 账号信息（游客态隐藏） -->
  <view wx:if="{{!isGuest}}" class="section">
    <view class="section-title">账号信息</view>
    <view class="list-container">
      <view class="list-item" bindtap="goEdit">
        <view class="list-item-content">
          <view class="list-icon-wrap primary"><van-icon name="contact" size="20px" color="#fff" /></view>
          <text class="list-item-label">个人资料</text>
        </view>
        <view class="list-item-right">
          <text class="list-item-value">{{user.nickname}}</text>
          <van-icon name="arrow" size="14px" color="#c4c4c4" />
        </view>
      </view>
    </view>
  </view>

  <!-- 关于 -->
  <view class="section">
    <view class="section-title">关于</view>
    <view class="list-container">
      <view class="list-item" bindtap="goToAbout">
        <view class="list-item-content">
          <view class="list-icon-wrap info"><van-icon name="info-o" size="20px" color="#fff" /></view>
          <text class="list-item-label">关于我们</text>
        </view>
        <view class="list-item-right">
          <van-icon name="arrow" size="14px" color="#c4c4c4" />
        </view>
      </view>

      <!-- 意见反馈：微信客服会话（open-type="contact"，需 button） -->
      <button
        class="list-item list-item-btn"
        open-type="contact"
        bindcontact="onContact"
        session-from="feedback"
      >
        <view class="list-item-content">
          <view class="list-icon-wrap accent"><van-icon name="service-o" size="20px" color="#fff" /></view>
          <text class="list-item-label">意见反馈</text>
        </view>
        <view class="list-item-right">
          <van-icon name="arrow" size="14px" color="#c4c4c4" />
        </view>
      </button>

      <view class="list-item" bindtap="goToVersion">
        <view class="list-item-content">
          <view class="list-icon-wrap gray"><van-icon name="setting-o" size="20px" color="#fff" /></view>
          <text class="list-item-label">版本信息</text>
        </view>
        <view class="list-item-right">
          <text class="list-item-value">v{{appVersion}}</text>
          <van-icon name="arrow" size="14px" color="#c4c4c4" />
        </view>
      </view>
    </view>
  </view>

  <!-- 退出登录（游客态隐藏） -->
  <view wx:if="{{!isGuest}}" class="logout-section">
    <view class="logout-btn" bindtap="logout">
      <text>退出登录</text>
    </view>
  </view>
</view>

<auth-drawer
  show="{{showAuthDrawer}}"
  default-avatar="{{userAvatar}}"
  default-nickname="{{userNickname}}"
  bind:authorized="onAuthorized"
  bind:close="onAuthClose"
/>
