<view class="profile-page">
  <!-- 用户信息卡片 -->
  <view class="user-card" bindtap="goEdit">
    <view class="avatar-section">
      <image class="avatar" src="{{user.avatar}}" mode="aspectFill" />
    </view>
    <view class="user-info">
      <text class="nickname">{{user.nickname}}</text>
    </view>
  </view>

  <!-- 账号信息 -->
  <view class="section">
    <view class="section-title">账号信息</view>
    <view class="list-container">
      <view class="list-item" bindtap="goEdit">
        <view class="list-item-content">
          <view class="list-icon-wrap primary"><van-icon name="contact" size="20px" color="#fff" /></view>
          <text class="list-item-label">个人资料</text>
        </view>
        <view class="list-item-right">
          <text class="list-item-value">{{user.nickname}}</text>
          <van-icon name="arrow" size="14px" color="#c4c4c4" />
        </view>
      </view>
    </view>
  </view>

  <!-- 关于 -->
  <view class="section">
    <view class="section-title">关于</view>
    <view class="list-container">
      <view class="list-item" bindtap="goToAbout">
        <view class="list-item-content">
          <view class="list-icon-wrap info"><van-icon name="info-o" size="20px" color="#fff" /></view>
          <text class="list-item-label">关于我们</text>
        </view>
        <view class="list-item-right">
          <van-icon name="arrow" size="14px" color="#c4c4c4" />
        </view>
      </view>

      <view class="list-item" bindtap="goToVersion">
        <view class="list-item-content">
          <view class="list-icon-wrap gray"><van-icon name="setting-o" size="20px" color="#fff" /></view>
          <text class="list-item-label">版本信息</text>
        </view>
        <view class="list-item-right">
          <text class="list-item-value">v1.0.0</text>
          <van-icon name="arrow" size="14px" color="#c4c4c4" />
        </view>
      </view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section">
    <view class="logout-btn" bindtap="logout">
      <text>退出登录</text>
    </view>
  </view>
</view>
