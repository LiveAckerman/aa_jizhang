.profile-card {
  display: flex;
  align-items: center;
  padding: 40rpx;
  margin-bottom: 24rpx;
}

.avatar-container {
  position: relative;
  margin-right: 32rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--color-secondary);
  border: 4rpx solid rgba(255, 255, 255, 0.8);
}

.avatar-edit-tip {
  position: absolute;
  bottom: -4rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 20rpx;
  color: #007AFF;
  background: rgba(255, 255, 255, 0.95);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.profile-info {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.user-id {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.menu-group {
  padding: 8rpx 40rpx;
  margin-bottom: 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  border-bottom: 1rpx solid rgba(47, 65, 89, 0.08);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-label {
  font-size: 30rpx;
  color: var(--text-primary);
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.menu-value {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.menu-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
}

.menu-arrow {
  font-size: 40rpx;
  color: var(--text-tertiary);
}

.logout-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: rgba(255, 59, 48, 0.1);
  color: #ff3b30;
  border-radius: 48rpx;
  font-size: 32rpx;
  margin-top: 48rpx;
}
