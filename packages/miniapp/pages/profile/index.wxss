/* 一级页面专属：青色圆点背景 */
page {
  background-color: #ffffff;
  background-image: radial-gradient(#7ec8d3 1px, transparent 1px);
  background-size: 16px 16px;
}

/* Apple Design Style - 个人中心页 */
.profile-page {
  min-height: 100vh;
  background: transparent;
  padding-bottom: 40rpx;
}

/* 用户信息卡片 */
.user-card {
  padding: 80rpx 32rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 头像区域 */
.avatar-section {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 100rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
}

.user-card {
  cursor: pointer;
}

/* 用户信息 */
.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nickname {
  font-size: 44rpx;
  font-weight: 700;
  color: #000000;
  margin-bottom: 8rpx;
}

.user-id {
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.6);
}

/* 分组 */
.section {
  margin-top: 40rpx;
  padding: 0 32rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 400;
  color: rgba(60, 60, 67, 0.6);
  text-transform: uppercase;
  letter-spacing: -0.08rpx;
  padding: 0 16rpx 16rpx;
}

/* 列表容器 */
.list-container {
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(30rpx) saturate(180%);
  border-radius: 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

/* 列表项 */
.list-item {
  min-height: 88rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.29);
  background: transparent;
  transition: background 0.2s;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item:active {
  background: rgba(0, 0, 0, 0.05);
}

.list-item-content {
  display: flex;
  align-items: center;
  flex: 1;
}

/* 彩色图标底块（替代 emoji） */
.list-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.list-icon-wrap.primary { background: linear-gradient(135deg, #4097a9, #5fb5c4); }
.list-icon-wrap.info    { background: linear-gradient(135deg, #5B8CFF, #6ea5ff); }
.list-icon-wrap.gray    { background: linear-gradient(135deg, #8091a5, #a1b0c3); }
.list-icon-wrap.accent  { background: linear-gradient(135deg, #fa9583, #ffb59f); }

/* 客服 button 重置为与 list-item 一致的外观 */
.list-item-btn {
  display: flex !important;
  width: 100% !important;
  margin: 0 !important;
  padding: 0 32rpx !important;
  box-sizing: border-box !important;
  line-height: normal;
  font-size: inherit;
  font-weight: normal;
  color: inherit;
  background: transparent;
  border-radius: 0;
  text-align: left;
}
.list-item-btn::after {
  border: none;
}

.list-item-label {
  font-size: 34rpx;
  color: #000000;
}

.list-item-right {
  display: flex;
  align-items: center;
}

.list-item-value {
  font-size: 30rpx;
  color: rgba(60, 60, 67, 0.6);
  margin-right: 16rpx;
}

.mini-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  margin-right: 16rpx;
}

/* van-icon 版本箭头样式统一，无需 arrow class */

/* 退出登录 */
.logout-section {
  padding: 48rpx 32rpx;
}

.logout-btn {
  height: 100rpx;
  background: #ffffff;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #FF3B30;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s;
}

.logout-btn:active {
  background: #fef2f2;
  transform: scale(0.98);
}
