/* Apple Design Style - 个人中心页 */
.profile-page {
  min-height: 100vh;
  background: #F2F2F7;
  padding-bottom: 40rpx;
}

/* 用户信息卡片 */
.user-card {
  padding: 80rpx 32rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 头像区域 */
.avatar-section {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 100rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
}

.avatar-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-text {
  font-size: 24rpx;
  color: #FFFFFF;
}

.edit-icon {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 56rpx;
  height: 56rpx;
  background: #007AFF;
  border-radius: 28rpx;
  border: 4rpx solid #F2F2F7;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 122, 255, 0.3);
}

.edit-icon .iconfont {
  font-size: 28rpx;
  color: #FFFFFF;
}

/* 用户信息 */
.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nickname {
  font-size: 44rpx;
  font-weight: 700;
  color: #000000;
  margin-bottom: 8rpx;
}

.user-id {
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.6);
}

/* 分组 */
.section {
  margin-top: 40rpx;
  padding: 0 32rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 400;
  color: rgba(60, 60, 67, 0.6);
  text-transform: uppercase;
  letter-spacing: -0.08rpx;
  padding: 0 16rpx 16rpx;
}

/* 列表容器 */
.list-container {
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(30rpx) saturate(180%);
  border-radius: 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

/* 列表项 */
.list-item {
  min-height: 88rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.29);
  background: transparent;
  transition: background 0.2s;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item:active {
  background: rgba(0, 0, 0, 0.05);
}

.list-item-content {
  display: flex;
  align-items: center;
  flex: 1;
}

.list-item-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
}

.list-item-label {
  font-size: 34rpx;
  color: #000000;
}

.list-item-right {
  display: flex;
  align-items: center;
}

.list-item-value {
  font-size: 30rpx;
  color: rgba(60, 60, 67, 0.6);
  margin-right: 16rpx;
}

.mini-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  margin-right: 16rpx;
}

.list-item-arrow {
  font-size: 40rpx;
  color: rgba(60, 60, 67, 0.3);
  font-weight: 300;
}

/* 退出登录 */
.logout-section {
  padding: 48rpx 32rpx;
}

.logout-btn {
  height: 100rpx;
  background: rgba(255, 59, 48, 0.15);
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #FF3B30;
  transition: all 0.2s;
}

.logout-btn:active {
  background: rgba(255, 59, 48, 0.25);
  transform: scale(0.98);
}
