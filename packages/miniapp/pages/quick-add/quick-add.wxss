.quick-page {
  padding: 24rpx 32rpx calc(160rpx + env(safe-area-inset-bottom));
}

/* 录入方式切换 */
.mode-switch {
  display: flex;
  background: rgba(64, 151, 169, 0.08);
  border-radius: 48rpx;
  padding: 8rpx;
  margin-bottom: 32rpx;
}
.mode-tab {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
}
.mode-tab.active {
  background: var(--color-primary);
  color: #fff;
  font-weight: 600;
}

.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.create-link {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 26rpx;
  color: var(--color-primary);
}

/* 搜索 */
.search-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 28rpx;
  background: #fff;
  border-radius: 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(47, 65, 89, 0.05);
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.tip {
  text-align: center;
  color: var(--text-secondary);
  font-size: 26rpx;
  padding: 80rpx 0;
}

/* 账本列表 */
.book-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.book-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  background: #fff;
  border-radius: 24rpx;
  border: 3rpx solid transparent;
  box-shadow: 0 4rpx 16rpx rgba(47, 65, 89, 0.05);
}
.book-item.active {
  border-color: var(--color-primary);
}
.book-cover {
  width: 96rpx;
  height: 96rpx;
  border-radius: 18rpx;
  background: #eee;
  flex-shrink: 0;
}
.book-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.book-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.book-meta {
  font-size: 24rpx;
  color: var(--text-secondary);
}
.book-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  border: 2rpx solid rgba(128, 145, 165, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.book-check.on {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

/* 底部 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  box-shadow: 0 -8rpx 32rpx rgba(47, 65, 89, 0.08);
}
.next-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
}
