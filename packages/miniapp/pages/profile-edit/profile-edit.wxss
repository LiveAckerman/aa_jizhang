.edit-page {
  min-height: 100vh;
  /* 背景继承全局圆点网格 */
  padding-bottom: 60rpx;
}

/* 微信 chooseAvatar button 需重置默认样式（含 min-width / display / box-sizing）*/
.avatar-btn {
  padding: 0;
  margin: 64rpx auto 20rpx;
  background: transparent;
  line-height: normal;
  min-height: 0;
  font-size: inherit;
  color: inherit;
  display: block;
  width: 200rpx !important;  /* !important 覆盖 button 默认宽度 */
  height: 200rpx;
  box-sizing: border-box;    /* 确保 border 不撑大容器 */
  overflow: visible;          /* 保留圆形阴影,不裁剪 */
}
.avatar-btn::after { border: none; }
/* 覆盖 avatar-section 的 margin，避免与 avatar-btn 的 margin 叠加 */
.avatar-btn.avatar-section { margin: 64rpx auto 20rpx; }

.list-item-btn {
  width: 100% !important;  /* !important 覆盖 button 默认宽度 */
  padding: 20rpx 32rpx;
  margin: 0;
  background: transparent;
  line-height: 1;
  border-radius: 0;
  text-align: left;
  min-height: 96rpx;
  font-size: inherit;
  color: inherit;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  border: none;
}
.list-item-btn::after { border: none; }

/* 头像大图 */
.avatar-section {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 64rpx auto 20rpx;
}

.avatar {
  /* 固定尺寸而非 width:100%，避免 button 容器被撑宽时图片跟着变形 */
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  box-sizing: border-box;
  /* button 内 image 默认 inline，居中并锁死为块级正方形 */
  display: block;
}

.avatar-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-text {
  font-size: 24rpx;
  color: #fff;
}

.camera-badge {
  position: absolute;
  right: 4rpx;
  bottom: 4rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: var(--color-primary);
  border: 4rpx solid #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(64, 151, 169, 0.4);
}

.avatar-tip {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 40rpx;
}

.section {
  padding: 0 32rpx;
}

.section-title {
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.6);
  padding: 0 16rpx 16rpx;
}

.list-container {
  background: rgba(255, 255, 255, 0.85);
  border-radius: 26rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.list-item {
  min-height: 96rpx;
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid rgba(60, 60, 67, 0.08);
}

.list-item:last-child { border-bottom: none; }
.list-item:active { background: rgba(0, 0, 0, 0.03); }

.list-item-content {
  display: flex;
  align-items: center;
  flex: 1;
}

.list-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.list-icon-wrap.primary { background: linear-gradient(135deg, #4097a9, #5fb5c4); }
.list-icon-wrap.accent  { background: linear-gradient(135deg, #fa9583, #ffb59f); }
.list-icon-wrap.gray    { background: linear-gradient(135deg, #8091a5, #a1b0c3); }

.list-item-label {
  font-size: 32rpx;
  color: var(--text-primary);
}

.list-item-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.list-item-value {
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.6);
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.id-text {
  font-size: 22rpx;
}

.mini-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: block;
  box-sizing: border-box;
  flex-shrink: 0;  /* 防止在 flex 容器中被压缩 */
}
