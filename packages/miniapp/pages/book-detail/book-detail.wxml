<view class="detail-page">
  <!-- 加载中：整页骨架屏 -->
  <block wx:if="{{loading}}">
    <view class="skeleton-header-card">
      <view class="skeleton-header-top">
        <view class="skeleton-avatars">
          <view class="skeleton-avatar" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
        </view>
        <view class="skeleton-menu-dot"></view>
      </view>
      <view class="skeleton-header-bottom">
        <view class="skeleton-line-24 w120"></view>
        <view class="skeleton-line-56 w280"></view>
        <view class="skeleton-line-22 w360"></view>
      </view>
    </view>

    <view class="skeleton-record-btn"></view>

    <view class="skeleton-quick-actions">
      <view class="skeleton-quick-item" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="skeleton-quick-icon"></view>
        <view class="skeleton-line-22 w60"></view>
      </view>
    </view>

    <view class="skeleton-tx-date"></view>
    <view class="glass-card skeleton-tx-list">
      <view class="skeleton-tx-item" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="skeleton-tx-icon"></view>
        <view class="skeleton-tx-mid">
          <view class="skeleton-line-28 w160"></view>
          <view class="skeleton-line-22 w220"></view>
        </view>
        <view class="skeleton-line-30 w120"></view>
      </view>
    </view>
  </block>

  <!-- 真实内容 -->
  <block wx:else>
    <!-- 头部卡片：封面 + 成员 + 金额 -->
    <view class="header-card">
      <image class="header-cover" src="{{coverUrl}}" mode="aspectFill" />
      <view class="header-overlay"></view>
      <view class="header-content">
        <view class="header-top">
          <view class="members-row">
            <image
              wx:for="{{members}}"
              wx:key="userId"
              class="member-avatar"
              src="{{item.avatar}}"
              mode="aspectFill"
              data-userid="{{item.userId}}"
              bindlongpress="onLongPressMember"
            />
            <view class="member-invite" bindtap="onInvite">
              <van-icon name="plus" size="18px" color="#4097a9" />
            </view>
          </view>
          <view class="header-actions">
            <book-menu book="{{book}}" is-owner="{{isOwner}}" light="{{true}}" bind:action="onBookAction" />
            <button class="header-share-btn" open-type="share">
              <van-icon name="share-o" size="18px" color="#fff" />
            </button>
          </view>
        </view>
        <view class="amount-block">
          <text class="amount-label">公账合计</text>
          <text class="amount-value">¥{{summaryText.sharedTotal}}</text>
          <text class="amount-sub">我的支出 ¥{{summaryText.myTotal}}（公账 {{summaryText.myShared}} + 私账 {{summaryText.myPrivate}}）</text>
        </view>
      </view>
    </view>

    <!-- 主操作：手动录入 + 票据自动识别 -->
    <view class="record-actions">
      <button class="record-btn manual" bindtap="onAddTransaction">
        <van-icon name="edit" size="18px" color="#fff" />
        <text>手动录入</text>
      </button>
      <button class="record-btn ocr" bindtap="onOcrRecognize">
        <van-icon name="scan" size="18px" color="#4097a9" />
        <text>票据自动识别</text>
      </button>
    </view>

    <!-- 待支付 / 待收款 统计卡片（点击进按人结算明细） -->
    <view class="settle-stat-card">
      <view class="settle-stat-item pay" data-tab="pay" bindtap="onOpenSettleDetail">
        <view class="settle-stat-icon pay">
          <van-icon name="cart-o" size="20px" color="#fa9583" />
        </view>
        <view class="settle-stat-text">
          <text class="settle-stat-label">待支付</text>
          <view class="settle-stat-amount">
            <text class="settle-stat-symbol">¥</text>
            <text class="settle-stat-num">{{summaryText.pendingPay}}</text>
          </view>
        </view>
        <van-icon class="settle-stat-arrow" name="arrow" size="14px" color="#c4c4c4" />
      </view>
      <view class="settle-stat-divider"></view>
      <view class="settle-stat-item receive" data-tab="receive" bindtap="onOpenSettleDetail">
        <view class="settle-stat-icon receive">
          <van-icon name="balance-o" size="20px" color="#4097a9" />
        </view>
        <view class="settle-stat-text">
          <text class="settle-stat-label">待收款</text>
          <view class="settle-stat-amount">
            <text class="settle-stat-symbol">¥</text>
            <text class="settle-stat-num">{{summaryText.pendingReceive}}</text>
          </view>
        </view>
        <van-icon class="settle-stat-arrow" name="arrow" size="14px" color="#c4c4c4" />
      </view>
    </view>

    <!-- 次要操作 -->
    <view class="quick-actions">
      <view class="quick-item" bindtap="onInvite">
        <van-icon name="friends-o" size="24px" color="#4097a9" />
        <text>邀请</text>
      </view>
      <view class="quick-item" bindtap="onSettlePartial">
        <van-icon name="balance-o" size="24px" color="#4097a9" />
        <text>部分结算</text>
      </view>
      <view class="quick-item" bindtap="onSettleAll">
        <van-icon name="completed" size="24px" color="#4097a9" />
        <text>全部结算</text>
      </view>
      <view class="quick-item" bindtap="onOpenSettleRounds">
        <view class="quick-item-icon-wrap">
          <van-icon name="notes-o" size="24px" color="#4097a9" />
          <view wx:if="{{activeRoundCount > 0}}" class="quick-item-badge">{{activeRoundCount}}</view>
        </view>
        <text>结算记录</text>
      </view>
      <!-- 统计暂时隐藏，后续可能放出来
      <view class="quick-item" bindtap="onStatistics">
        <van-icon name="chart-trending-o" size="24px" color="#4097a9" />
        <text>统计</text>
      </view>
      -->
    </view>

    <!-- 账单筛选 tab：全部 / 公账 / 私账 -->
    <view class="tx-filter">
      <view class="tx-filter-tab {{txFilter === 'all' ? 'active' : ''}}" data-val="all" bindtap="onPickTxFilter">
        <text>全部</text>
        <!-- 角标暂时隐藏，后续可能恢复
        <text wx:if="{{txCounts.all > 0}}" class="tx-filter-badge">{{txCounts.all}}</text>
        -->
      </view>
      <view class="tx-filter-tab {{txFilter === 'shared' ? 'active' : ''}}" data-val="shared" bindtap="onPickTxFilter">
        <text>公账</text>
        <!-- <text wx:if="{{txCounts.shared > 0}}" class="tx-filter-badge">{{txCounts.shared}}</text> -->
      </view>
      <view class="tx-filter-tab {{txFilter === 'private' ? 'active' : ''}}" data-val="private" bindtap="onPickTxFilter">
        <text>私账</text>
        <!-- <text wx:if="{{txCounts.private > 0}}" class="tx-filter-badge">{{txCounts.private}}</text> -->
      </view>
    </view>

    <!-- 空流水 -->
    <view wx:if="{{groups.length === 0}}" class="empty-tx">
      <image class="empty-tx-img" src="https://cdn.ljw44.com/assets/illustrations/empty-transactions.png" mode="aspectFit" />
      <text class="empty-tx-text">{{txFilter === 'all' ? '还没有账单，点上方「记一笔」记第一笔' : '该分类下暂无账单'}}</text>
    </view>

    <!-- 流水 -->
    <view class="tx-groups">
      <view wx:for="{{groups}}" wx:key="date" class="tx-group">
        <view class="tx-date">{{item.date}}</view>
        <view class="glass-card tx-list">
          <view
            wx:for="{{item.items}}"
            wx:for-item="tx"
            wx:key="id"
            class="tx-item {{tx.isPrivate ? 'private' : ''}} {{tx.isMyPayment ? 'my-payment' : ''}}"
            data-id="{{tx.id}}"
            bindtap="onTapTransaction"
          >
            <view class="tx-icon">
              <van-icon name="{{tx.categoryIcon}}" size="22px" color="#4097a9" />
            </view>
            <view class="tx-mid">
              <view class="tx-title-row">
                <text class="tx-cat">{{tx.categoryName}}</text>
                <van-icon wx:if="{{tx.isPrivate}}" name="lock" size="13px" color="#8091a5" />
                <text wx:if="{{tx.settling}}" class="tx-settling-tag">结算中</text>
              </view>
              <text class="tx-note">{{tx.note || tx.payerName + ' 付款'}}</text>
              <!-- 我应收/我应付暂时隐藏，后续可能恢复
              <text wx:if="{{tx.myReceiveText}}" class="tx-myshare receive">我应收 ¥{{tx.myReceiveText}}</text>
              <text wx:elif="{{tx.myShareText}}" class="tx-myshare">我应付 ¥{{tx.myShareText}}</text>
              -->
            </view>
            <text class="tx-amount">¥{{tx.amountText}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 已结算账单：通用堆叠组件（折叠堆叠 / 展开列表） -->
    <card-stack
      wx:if="{{settledList.length > 0}}"
      count="{{settledList.length}}"
      title="已结算账单（{{settledList.length}}）"
      hint-text="共 {{settledList.length}} 笔已结算，点击展开"
    >
      <!-- 折叠态顶部卡片：最新一条 -->
      <view slot="top" class="glass-card tx-list">
        <view class="tx-item {{settledList[0].isMyPayment ? 'my-payment' : ''}}">
          <view class="tx-icon">
            <van-icon name="{{settledList[0].categoryIcon}}" size="22px" color="#4097a9" />
          </view>
          <view class="tx-mid">
            <view class="tx-title-row">
              <text class="tx-cat">{{settledList[0].categoryName}}</text>
              <text class="tx-settled-tag">已结算</text>
            </view>
            <text class="tx-note">{{settledList[0].note || settledList[0].payerName + ' 付款'}}</text>
          </view>
          <text class="tx-amount">¥{{settledList[0].amountText}}</text>
        </view>
      </view>

      <!-- 展开态完整列表 -->
      <view slot="list" class="glass-card tx-list">
        <view
          wx:for="{{settledList}}"
          wx:key="id"
          wx:for-item="tx"
          class="tx-item {{tx.isPrivate ? 'private' : ''}} {{tx.isMyPayment ? 'my-payment' : ''}}"
          data-id="{{tx.id}}"
          bindtap="onTapTransaction"
        >
          <view class="tx-icon">
            <van-icon name="{{tx.categoryIcon}}" size="22px" color="#4097a9" />
          </view>
          <view class="tx-mid">
            <view class="tx-title-row">
              <text class="tx-cat">{{tx.categoryName}}</text>
              <van-icon wx:if="{{tx.isPrivate}}" name="lock" size="13px" color="#8091a5" />
              <text class="tx-settled-tag">已结算</text>
            </view>
            <text class="tx-note">{{tx.note || tx.payerName + ' 付款'}}</text>
          </view>
          <text class="tx-amount">¥{{tx.amountText}}</text>
        </view>
      </view>
    </card-stack>
  </block>
</view>

<!-- 进行中轮次弹窗（部分结算前） -->
<view wx:if="{{showRoundDrawer}}" class="round-mask" catchtap="onCloseRoundDrawer">
  <view class="round-panel" catchtap="stopPropagation">
    <view class="round-panel-header">
      <text class="round-panel-title">有进行中的结算</text>
      <van-icon name="cross" size="18px" color="#8091a5" catchtap="onCloseRoundDrawer" />
    </view>
    <text class="round-panel-sub">可继续处理，或直接开启新一轮结算</text>
    <view class="round-list">
      <view wx:for="{{activeRounds}}" wx:key="id" class="round-item">
        <view class="round-item-main" data-id="{{item.id}}" catchtap="onTapRound">
          <view class="round-item-top">
            <text class="round-item-type">{{item.typeText}}</text>
            <text class="round-item-badge">进行中</text>
          </view>
          <text class="round-item-meta">{{item.txCount}} 笔 · ¥{{item.amountText}} · {{item.dateText}}</text>
        </view>
        <view class="round-item-del" data-id="{{item.id}}" catchtap="onDeleteRound">
          <van-icon name="delete-o" size="18px" color="#fa9583" />
        </view>
      </view>
    </view>
    <button class="round-new-btn" catchtap="onStartNewRound">开启新一轮部分结算</button>
  </view>
</view>
