<view class="detail-page">
  <!-- 加载中：整页骨架屏 -->
  <block wx:if="{{loading}}">
    <view class="skeleton-header-card">
      <view class="skeleton-header-top">
        <view class="skeleton-avatars">
          <view class="skeleton-avatar" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
        </view>
        <view class="skeleton-menu-dot"></view>
      </view>
      <view class="skeleton-header-bottom">
        <view class="skeleton-line-24 w120"></view>
        <view class="skeleton-line-56 w280"></view>
        <view class="skeleton-line-22 w360"></view>
      </view>
    </view>

    <view class="skeleton-record-btn"></view>

    <view class="skeleton-quick-actions">
      <view class="skeleton-quick-item" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="skeleton-quick-icon"></view>
        <view class="skeleton-line-22 w60"></view>
      </view>
    </view>

    <view class="skeleton-tx-date"></view>
    <view class="glass-card skeleton-tx-list">
      <view class="skeleton-tx-item" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="skeleton-tx-icon"></view>
        <view class="skeleton-tx-mid">
          <view class="skeleton-line-28 w160"></view>
          <view class="skeleton-line-22 w220"></view>
        </view>
        <view class="skeleton-line-30 w120"></view>
      </view>
    </view>
  </block>

  <!-- 真实内容 -->
  <block wx:else>
    <!-- 头部卡片：封面 + 成员 + 金额 -->
    <view class="header-card">
      <image class="header-cover" src="{{coverUrl}}" mode="aspectFill" />
      <view class="header-overlay"></view>
      <view class="header-content">
        <view class="header-top">
          <view class="members-row">
            <image
              wx:for="{{members}}"
              wx:key="userId"
              class="member-avatar"
              src="{{item.avatar}}"
              mode="aspectFill"
              data-userid="{{item.userId}}"
              bindlongpress="onLongPressMember"
            />
            <view class="member-invite" bindtap="onInvite">
              <van-icon name="plus" size="18px" color="#4097a9" />
            </view>
          </view>
          <book-menu book="{{book}}" is-owner="{{isOwner}}" light="{{true}}" bind:action="onBookAction" />
        </view>
        <view class="amount-block">
          <text class="amount-label">公账支出</text>
          <text class="amount-value">¥{{summaryText.sharedTotal}}</text>
          <text class="amount-sub">我的支出 ¥{{summaryText.myTotal}}（公账 {{summaryText.myShared}} + 私账 {{summaryText.myPrivate}}）</text>
        </view>
      </view>
    </view>

    <!-- 主操作：手动录入 + 自动票据识别 -->
    <view class="record-actions">
      <button class="record-btn manual" bindtap="onAddTransaction">
        <van-icon name="edit" size="18px" color="#fff" />
        <text>手动录入</text>
      </button>
      <button class="record-btn ocr" bindtap="onOcrRecognize">
        <van-icon name="scan" size="18px" color="#4097a9" />
        <text>自动票据识别</text>
      </button>
    </view>

    <!-- 次要操作 -->
    <view class="quick-actions">
      <view class="quick-item" bindtap="onInvite">
        <van-icon name="friends-o" size="24px" color="#4097a9" />
        <text>邀请</text>
      </view>
      <view class="quick-item" bindtap="onSettlement">
        <van-icon name="balance-o" size="24px" color="#4097a9" />
        <text>结算</text>
      </view>
      <view class="quick-item" bindtap="onStatistics">
        <van-icon name="chart-trending-o" size="24px" color="#4097a9" />
        <text>统计</text>
      </view>
      <button class="quick-item share-btn" open-type="share">
        <van-icon name="share-o" size="24px" color="#4097a9" />
        <text>分享</text>
      </button>
    </view>

    <!-- 账单筛选 tab：全部 / 公账 / 私账 -->
    <view class="tx-filter">
      <view class="tx-filter-tab {{txFilter === 'all' ? 'active' : ''}}" data-val="all" bindtap="onPickTxFilter">全部</view>
      <view class="tx-filter-tab {{txFilter === 'shared' ? 'active' : ''}}" data-val="shared" bindtap="onPickTxFilter">公账</view>
      <view class="tx-filter-tab {{txFilter === 'private' ? 'active' : ''}}" data-val="private" bindtap="onPickTxFilter">私账</view>
    </view>

    <!-- 筛选统计条 -->
    <view class="tx-filter-stat">
      <text class="stat-label">{{txFilter === 'shared' ? '公账' : txFilter === 'private' ? '私账' : '全部'}}共 {{filterStat.count}} 笔</text>
      <text class="stat-amount">合计 ¥{{filterStat.amountText}}</text>
    </view>

    <!-- 空流水 -->
    <view wx:if="{{groups.length === 0}}" class="empty-tx">
      <image class="empty-tx-img" src="https://cdn.ljw44.com/assets/illustrations/empty-transactions.png" mode="aspectFit" />
      <text class="empty-tx-text">{{txFilter === 'all' ? '还没有账单，点上方「记一笔」记第一笔' : '该分类下暂无账单'}}</text>
    </view>

    <!-- 流水 -->
    <view class="tx-groups">
      <view wx:for="{{groups}}" wx:key="date" class="tx-group">
        <view class="tx-date">{{item.date}}</view>
        <view class="glass-card tx-list">
          <view
            wx:for="{{item.items}}"
            wx:for-item="tx"
            wx:key="id"
            class="tx-item {{tx.isPrivate ? 'private' : ''}}"
            data-id="{{tx.id}}"
            bindtap="onTapTransaction"
          >
            <view class="tx-icon">
              <van-icon name="{{tx.categoryIcon}}" size="22px" color="#4097a9" />
            </view>
            <view class="tx-mid">
              <view class="tx-title-row">
                <text class="tx-cat">{{tx.categoryName}}</text>
                <van-icon wx:if="{{tx.isPrivate}}" name="lock" size="13px" color="#8091a5" />
              </view>
              <text class="tx-note">{{tx.note || tx.payerName + ' 付款'}}</text>
              <text wx:if="{{tx.myShareText}}" class="tx-myshare">我应付 ¥{{tx.myShareText}}</text>
            </view>
            <text class="tx-amount">¥{{tx.amountText}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>
