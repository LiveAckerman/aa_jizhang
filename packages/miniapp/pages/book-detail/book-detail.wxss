.detail-page {
  padding: 0 32rpx calc(60rpx + env(safe-area-inset-bottom));
}

/* 头部卡片 */
.header-card {
  position: relative;
  height: 320rpx;
  border-radius: 32rpx;
  overflow: hidden;
  margin-top: 24rpx;
}

.header-cover {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.header-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(47, 65, 89, 0.15), rgba(47, 65, 89, 0.65));
}

.header-content {
  position: absolute;
  inset: 0;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.members-row {
  display: flex;
  align-items: center;
}

.member-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  border: 2rpx solid #fff;
  margin-right: -14rpx;
  background: #eee;
}

.member-invite {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
}

.more-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.amount-block {
  display: flex;
  flex-direction: column;
}

.amount-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.amount-value {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
}

.amount-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
}

/* 快捷操作 */
.quick-actions {
  display: flex;
  justify-content: space-around;
  margin: 24rpx 0;
  padding: 28rpx 0;
  background: var(--bg-card);
  border-radius: 32rpx;
  box-shadow: 0 16rpx 64rpx rgba(47, 65, 89, 0.08);
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--text-primary);
  background: transparent;
  line-height: 1.4;
  margin: 0;
  padding: 0;
}

.quick-item text {
  margin-top: 10rpx;
}

/* button 版快捷项：清掉小程序 button 默认样式，与 view 项对齐 */
.share-btn {
  border: none;
  border-radius: 0;
}

.share-btn::after {
  border: none;
}

/* 账单筛选 tab */
.tx-filter {
  display: flex;
  background: rgba(64, 151, 169, 0.08);
  border-radius: 40rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}

.tx-filter-tab {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 34rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.tx-filter-tab.active {
  background: var(--color-primary);
  color: #fff;
  font-weight: 600;
}

/* 筛选统计条 */
.tx-filter-stat {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 20rpx;
}

.tx-filter-stat .stat-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.tx-filter-stat .stat-amount {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-accent);
}

/* 流水 */
.tx-date {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin: 24rpx 8rpx 12rpx;
}

.tx-list {
  padding: 8rpx 24rpx;
}

.tx-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid rgba(128, 145, 165, 0.12);
}

.tx-item:last-child {
  border-bottom: none;
}

.tx-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: rgba(64, 151, 169, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.tx-item.private .tx-icon {
  background: rgba(47, 65, 89, 0.1);
}

.tx-mid {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.tx-title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  overflow: hidden;
}

.tx-cat {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  flex-shrink: 0;
}

/* 已结算小标签 */
.tx-settled-tag {
  font-size: 18rpx;
  color: #52c41a;
  background: rgba(82, 196, 26, 0.12);
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
}

/* 已结算账单堆叠 */
.settled-stack {
  margin-top: 32rpx;
}
.settled-card {
  position: relative;
  margin-bottom: 0;
  /* 后一张上移压在前一张底部，露出前一张标题行区域 */
  margin-top: -110rpx;
  border: 2rpx solid rgba(128, 145, 165, 0.10);
  /* 顶部投影：本卡压在下方卡片之上（DOM 后渲染的天然层级更高） */
  box-shadow: 0 -6rpx 18rpx rgba(47, 65, 89, 0.08);
  transition: transform 0.2s;
}
/* 第一张（最新）不上移，投影正常 */
.settled-card.first {
  margin-top: 0;
  box-shadow: 0 4rpx 16rpx rgba(47, 65, 89, 0.06);
}
/* 堆叠卡片内 tx-item 沿用账单原样式，仅去掉分隔线 */
.settled-card .tx-item {
  border: none;
}

/* 堆叠点击提示 */
.settled-hint {
  margin-top: 12rpx;
  padding: 16rpx 24rpx;
  background: rgba(64, 151, 169, 0.06);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 抽屉遮罩 */
.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}
.drawer-panel {
  width: 100%;
  max-height: 80vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 0 0;
  display: flex;
  flex-direction: column;
}
.drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx 20rpx;
  position: relative;
}
.drawer-handle {
  position: absolute;
  top: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 72rpx;
  height: 8rpx;
  background: rgba(128, 145, 165, 0.2);
  border-radius: 4rpx;
}
.drawer-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  text-align: center;
}
.drawer-scroll {
  flex: 1;
  overflow-y: auto;
}
.drawer-tx-list {
  margin: 0 32rpx 32rpx;
}

.tx-note {
  font-size: 24rpx;
  color: var(--text-secondary);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tx-myshare {
  font-size: 22rpx;
  color: var(--color-primary);
  margin-top: 6rpx;
}

.tx-notinvolved {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  opacity: 0.7;
}

.tx-amount {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-accent);
}

.empty-tx {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-tx-img {
  width: 300rpx;
  height: 240rpx;
}

.empty-tx-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 24rpx;
}

/* ============ 骨架屏 ============ */
.skeleton-header-card {
  height: 320rpx;
  border-radius: 32rpx;
  background: linear-gradient(180deg, #e6ebef 0%, #d5dde4 100%);
  margin-top: 24rpx;
  padding: 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  animation: skel-blink 1.2s ease-in-out infinite;
}

.skeleton-header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.skeleton-avatars {
  display: flex;
}

.skeleton-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 2rpx solid #fff;
  margin-right: -14rpx;
}

.skeleton-menu-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.35);
}

.skeleton-header-bottom {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.skeleton-line-22 { height: 22rpx; border-radius: 11rpx; background: rgba(255, 255, 255, 0.6); }
.skeleton-line-24 { height: 24rpx; border-radius: 12rpx; background: rgba(255, 255, 255, 0.6); }
.skeleton-line-28 { height: 28rpx; border-radius: 14rpx; background: #f2f3f5; }
.skeleton-line-30 { height: 30rpx; border-radius: 14rpx; background: #f2f3f5; }
.skeleton-line-56 { height: 56rpx; border-radius: 16rpx; background: rgba(255, 255, 255, 0.7); }
.w60 { width: 60rpx; } .w120 { width: 120rpx; } .w160 { width: 160rpx; }
.w220 { width: 220rpx; } .w280 { width: 280rpx; } .w360 { width: 360rpx; }

.skeleton-record-btn {
  width: 100%;
  height: 108rpx;
  margin: 28rpx 0 16rpx;
  border-radius: 48rpx;
  background: #f2f3f5;
  animation: skel-blink 1.2s ease-in-out infinite;
}

.skeleton-quick-actions {
  display: flex;
  justify-content: space-around;
  padding: 28rpx 0;
  border-radius: 32rpx;
  background: var(--bg-card);
  box-shadow: 0 16rpx 64rpx rgba(47, 65, 89, 0.08);
  margin-bottom: 24rpx;
}

.skeleton-quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.skeleton-quick-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #f2f3f5;
  animation: skel-blink 1.2s ease-in-out infinite;
}

.skeleton-tx-date {
  width: 200rpx;
  height: 24rpx;
  border-radius: 12rpx;
  background: #f2f3f5;
  margin: 24rpx 8rpx 12rpx;
  animation: skel-blink 1.2s ease-in-out infinite;
}

.skeleton-tx-list {
  padding: 8rpx 24rpx;
}

.skeleton-tx-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid rgba(128, 145, 165, 0.12);
}

.skeleton-tx-item:last-child {
  border-bottom: none;
}

.skeleton-tx-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #f2f3f5;
  margin-right: 20rpx;
  animation: skel-blink 1.2s ease-in-out infinite;
}

.skeleton-tx-mid {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

@keyframes skel-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}

/* 主 CTA：记一笔（页内独立按钮） */
/* 手动录入 + 自动票据识别 双按钮 */
.record-actions {
  display: flex;
  gap: 20rpx;
  margin: 28rpx 0 16rpx;
}
.record-btn {
  flex: 1;
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}
.record-btn::after { border: none; }
.record-btn.manual {
  background: var(--color-accent);
  color: #fff;
  box-shadow: 0 12rpx 32rpx rgba(250, 149, 131, 0.35);
}
.record-btn.ocr {
  background: rgba(64, 151, 169, 0.1);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}
