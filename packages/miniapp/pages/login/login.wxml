<view class="login-page">
  <!-- Logo 和标题区域 -->
  <view class="header-section">
    <view class="logo-container">
      <image class="app-logo" src="/assets/logo.png" mode="aspectFit" />
    </view>
    <view class="brand-name">
      <text class="name-chinese">出发AA记账</text>
    </view>
    <text class="brand-english">DEPARTUREAA</text>
    <text class="slogan">和朋友一起，轻松记账分账</text>
  </view>

  <!-- 登录卡片 -->
  <view class="login-card">
    <view class="card-header">
      <text class="welcome-text">欢迎使用出发AA记账</text>
    </view>

    <!-- 微信登录按钮 -->
    <button
      class="wechat-login-btn"
      bindtap="handleWechatLogin"
      disabled="{{logining}}"
    >
      <image class="wechat-icon" src="/assets/wechat-icon.png" mode="aspectFit" />
      <text>{{logining ? '登录中...' : '微信一键登录'}}</text>
    </button>

    <!-- 其他登录方式 -->
    <view class="divider">
      <view class="divider-line"></view>
      <text class="divider-text">其他登录方式</text>
      <view class="divider-line"></view>
    </view>

    <!-- 协议 -->
    <view class="agreement">
      <view class="checkbox-wrapper" bindtap="toggleAgree">
        <view class="checkbox {{agreed ? 'checked' : ''}}">
          <text wx:if="{{agreed}}" class="checkbox-icon">✓</text>
        </view>
      </view>
      <text class="agreement-text">登录即代表同意</text>
      <text class="agreement-link">《用户协议》</text>
      <text class="agreement-text">和</text>
      <text class="agreement-link">《隐私政策》</text>
    </view>
  </view>

  <!-- 底部特性 -->
  <view class="features">
    <view class="feature-item">
      <view class="feature-icon-box feature-icon-multi">
        <text class="feature-icon-text">多</text>
      </view>
      <text class="feature-title">多人记账</text>
      <text class="feature-desc">一起出行</text>
      <text class="feature-desc">账目清晰</text>
    </view>
    <view class="feature-item">
      <view class="feature-icon-box feature-icon-smart">
        <text class="feature-icon-text">¥</text>
      </view>
      <text class="feature-title">智能分账</text>
      <text class="feature-desc">自动计算</text>
      <text class="feature-desc">公平透明</text>
    </view>
    <view class="feature-item">
      <view class="feature-icon-box feature-icon-secure">
        <text class="feature-icon-text">✓</text>
      </view>
      <text class="feature-title">安全可靠</text>
      <text class="feature-desc">数据加密</text>
      <text class="feature-desc">隐私保护</text>
    </view>
  </view>
</view>
