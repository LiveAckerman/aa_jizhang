<view class="login-page">
  <!-- Logo 和标题区域 -->
  <view class="header-section">
    <view class="logo-container">
      <image class="app-logo" src="https://cdn.ljw44.com/assets/logo/logo-card.webp" mode="aspectFit" />
    </view>
    <image
      class="brand-wordmark"
      src="https://cdn.ljw44.com/images/2026-08/wordmark.webp"
      mode="aspectFit"
    />
    <text class="brand-english">一起分账吧</text>
    <text class="slogan">和朋友一起，轻松记账分账</text>
  </view>

  <!-- 登录卡片 -->
  <view class="login-card">
    <view class="card-header">
      <text class="welcome-text">欢迎使用一起分账吧</text>
    </view>

    <!-- 微信登录按钮 -->
    <button
      class="wechat-login-btn"
      bindtap="handleWechatLogin"
      disabled="{{logining}}"
    >
      <view wx:if="{{logining}}" class="btn-spinner"></view>
      <image wx:else class="wechat-icon" src="/assets/wechat-logo.png" mode="aspectFit" />
      <text>{{logining ? '登录中...' : '微信一键登录'}}</text>
    </button>

    <!-- 协议 -->
    <view class="agreement">
      <view class="checkbox-wrapper" bindtap="toggleAgree">
        <view class="checkbox {{agreed ? 'checked' : ''}}">
          <text wx:if="{{agreed}}" class="checkbox-icon">✓</text>
        </view>
      </view>
      <text class="agreement-text">我已阅读并同意</text>
      <navigator url="/packageB/pages/document/document?type=terms" class="agreement-link" hover-class="none">《用户协议》</navigator>
      <text class="agreement-text">和</text>
      <navigator url="/packageB/pages/document/document?type=privacy" class="agreement-link" hover-class="none">《隐私政策》</navigator>
    </view>
  </view>
</view>
