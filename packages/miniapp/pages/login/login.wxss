/* 登录页面 */
.login-page {
  min-height: 100vh;
  background-image: url('https://cdn.ljw44.com/assets/backgrounds/login-bg.png');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 40rpx;
  box-sizing: border-box;
}

/* Logo 和标题区域 */
.header-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 120rpx;
}

.logo-container {
  width: 200rpx;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.app-logo {
  width: 200rpx;
  height: 200rpx;
}

.brand-wordmark {
  width: 320rpx;
  height: 96rpx;
  margin-bottom: 16rpx;
}

.brand-english {
  font-size: 28rpx;
  color: rgba(47, 65, 89, 0.6);
  letter-spacing: 4rpx;
  margin-bottom: 24rpx;
}

.slogan {
  font-size: 28rpx;
  color: rgba(47, 65, 89, 0.7);
}

/* 登录卡片 */
.login-card {
  width: 100%;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.08);
  margin-bottom: calc(80rpx + constant(safe-area-inset-bottom));
  margin-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
}

.welcome-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #2f4159;
}

/* 微信登录按钮 */
.wechat-login-btn {
  width: 100%;
  height: 96rpx;
  background: #07C160;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
  transition: all 0.3s;
  margin-bottom: 32rpx;
}

.wechat-login-btn::after {
  border: none;
}

.wechat-login-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.2);
}

/* 覆盖微信 button 禁用态的默认灰白样式，保持绿色 */
.wechat-login-btn[disabled],
.wechat-login-btn[disabled]:not([type]) {
  background: #07C160;
  color: #FFFFFF;
  opacity: 0.7;
}

.wechat-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
}

/* 登录中：CSS spinner，替换 wechat-icon */
.btn-spinner {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #ffffff;
  animation: btn-spin 0.7s linear infinite;
}

@keyframes btn-spin {
  to { transform: rotate(360deg); }
}

/* 协议 */
.agreement {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
}

.checkbox-wrapper {
  margin-right: 12rpx;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid rgba(47, 65, 89, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.checkbox.checked {
  background: #07C160;
  border-color: #07C160;
}

.checkbox-icon {
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: bold;
}

.agreement-text {
  font-size: 24rpx;
  color: rgba(47, 65, 89, 0.6);
  margin: 0 4rpx;
}

.agreement-link {
  font-size: 24rpx;
  color: #5AC8FA;
  margin: 0 4rpx;
}
