/* 登录页面 */
.login-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #5AC8FA 0%, #FFE8D6 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 40rpx;
  box-sizing: border-box;
}

/* Logo 和标题区域 */
.header-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 120rpx;
  margin-bottom: 80rpx;
}

.logo-container {
  width: 200rpx;
  height: 200rpx;
  background: #FFFFFF;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
  margin-bottom: 40rpx;
}

.app-logo {
  width: 160rpx;
  height: 160rpx;
}

.brand-name {
  margin-bottom: 16rpx;
}

.name-chinese {
  font-size: 48rpx;
  font-weight: 700;
  background: linear-gradient(90deg, #5AC8FA 0%, #FF9F6D 50%, #FFB84D 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.brand-english {
  font-size: 28rpx;
  color: rgba(47, 65, 89, 0.6);
  letter-spacing: 4rpx;
  margin-bottom: 24rpx;
}

.slogan {
  font-size: 28rpx;
  color: rgba(47, 65, 89, 0.7);
}

/* 登录卡片 */
.login-card {
  width: 100%;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 80rpx;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
}

.welcome-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #2f4159;
}

/* 微信登录按钮 */
.wechat-login-btn {
  width: 100%;
  height: 96rpx;
  background: #07C160;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
  transition: all 0.3s;
}

.wechat-login-btn::after {
  border: none;
}

.wechat-login-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.2);
}

.wechat-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
}

/* 分割线 */
.divider {
  display: flex;
  align-items: center;
  margin: 40rpx 0;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: rgba(47, 65, 89, 0.1);
}

.divider-text {
  font-size: 24rpx;
  color: rgba(47, 65, 89, 0.4);
  margin: 0 24rpx;
}

/* 协议 */
.agreement {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
}

.checkbox-wrapper {
  margin-right: 12rpx;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid rgba(47, 65, 89, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.checkbox.checked {
  background: #07C160;
  border-color: #07C160;
}

.checkbox-icon {
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: bold;
}

.agreement-text {
  font-size: 24rpx;
  color: rgba(47, 65, 89, 0.6);
  margin: 0 4rpx;
}

.agreement-link {
  font-size: 24rpx;
  color: #5AC8FA;
  margin: 0 4rpx;
}

/* 底部特性 */
.features {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding-bottom: 60rpx;
}

.feature-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 20rpx;
}

.feature-icon-box {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.feature-icon-multi {
  background: linear-gradient(135deg, #E0F7FF 0%, #B3E5FC 100%);
}

.feature-icon-smart {
  background: linear-gradient(135deg, #FFF4E6 0%, #FFE0B2 100%);
}

.feature-icon-secure {
  background: linear-gradient(135deg, #FFE8F0 0%, #FFD1E3 100%);
}

.feature-emoji {
  font-size: 56rpx;
  line-height: 1;
}

.feature-icon-text {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1;
}

.feature-icon-multi .feature-icon-text {
  color: #5AC8FA;
}

.feature-icon-smart .feature-icon-text {
  color: #FFB84D;
}

.feature-icon-secure .feature-icon-text {
  color: #FF6B9D;
}

.feature-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2f4159;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 22rpx;
  color: rgba(47, 65, 89, 0.6);
  line-height: 32rpx;
}
