<view class="edit-nickname-page">
  <nav-bar title="修改昵称" show-back="{{false}}">
    <text slot="left" class="nav-action" bindtap="onCancel">取消</text>
    <text slot="right" class="nav-action nav-action--primary" bindtap="onSave">保存</text>
  </nav-bar>

  <view class="content">
    <view class="input-container">
      <input
        class="nickname-input"
        value="{{nickname}}"
        placeholder="请输入昵称"
        placeholder-class="placeholder"
        maxlength="20"
        focus="{{true}}"
        bindinput="onInput"
      />
      <text class="count">{{nickname.length}}/20</text>
    </view>

    <view class="tips">
      <text class="tip-item">• 昵称长度为1-20个字符</text>
      <text class="tip-item">• 昵称将在账本中展示给好友</text>
    </view>
  </view>
</view>
