page {
  /* 背景继承全局圆点网格 */
  min-height: 100vh;
}

/* 导航栏操作按钮（配合 nav-bar 左右插槽） */
.nav-action {
  font-size: 32rpx;
  color: #8091a5;
  padding: 8rpx 16rpx;
}

.nav-action--primary {
  color: #4097a9;
  font-weight: 600;
}

.content {
  padding: 48rpx 32rpx;
}

.input-container {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(107, 95, 232, 0.08);
  margin-bottom: 32rpx;
}

.nickname-input {
  font-size: 32rpx;
  color: #1F2421;
  line-height: 48rpx;
}

.placeholder {
  color: #C1C6C8;
}

.count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}

.tips {
  padding: 24rpx 32rpx;
}

.tip-item {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 40rpx;
  margin-bottom: 8rpx;
}

.save-btn {
  margin-top: 48rpx;
}
