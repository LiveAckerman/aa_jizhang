.join-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.join-loading,
.join-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  color: var(--text-secondary);
  font-size: 28rpx;
  padding-top: 80rpx;
}

.error-text {
  font-size: 30rpx;
  color: var(--text-primary);
}

.join-card {
  width: 100%;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.join-cover {
  width: 200rpx;
  height: 200rpx;
  border-radius: 32rpx;
  margin-bottom: 32rpx;
  background: var(--color-secondary);
}

.join-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.join-meta {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
}

.join-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  margin-top: 48rpx;
}

.back-btn {
  width: 300rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 24rpx;
}

.join-cancel {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 28rpx;
}
