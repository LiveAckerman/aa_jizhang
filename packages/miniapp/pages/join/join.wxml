<view class="join-page">
  <!-- 骨架屏 -->
  <view wx:if="{{loading}}" class="join-body">
    <view class="glass-card join-card">
      <view class="sk-cover"></view>
      <view class="sk-line sk-line-title"></view>
      <view class="sk-line sk-line-scene"></view>
      <view class="sk-line sk-line-meta"></view>
      <view class="sk-pill"></view>
    </view>
    <view class="glass-card join-intro">
      <view class="sk-line sk-line-sub"></view>
      <view class="sk-feature" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="sk-feature-icon"></view>
        <view class="sk-feature-lines">
          <view class="sk-line sk-line-fname"></view>
          <view class="sk-line sk-line-fdesc"></view>
        </view>
      </view>
    </view>
    <view class="sk-btn"></view>
  </view>

  <view wx:elif="{{error}}" class="join-error">
    <van-icon name="warning-o" size="48px" color="#fa9583" />
    <text class="error-text">{{error}}</text>
    <button class="btn-primary back-btn" bindtap="onCancel">返回账本</button>
  </view>

  <view wx:else class="join-body">
    <!-- 邀请卡片 -->
    <view class="glass-card join-card">
      <view class="join-cover-wrap">
        <image class="join-cover" src="{{coverUrl}}" mode="aspectFill" />
      </view>
      <text class="join-name">{{info.name}}</text>
      <view wx:if="{{info.sceneName}}" class="join-scene">{{info.sceneName}}</view>

      <view class="join-inviter">
        <text class="join-inviter-name">{{info.ownerName}}</text>
        <text class="join-inviter-text">邀请你加入账本</text>
      </view>

      <view class="join-member-count">
        <van-icon name="friends-o" size="16px" color="#4097a9" />
        <text>当前 {{info.memberCount}} 位成员</text>
      </view>
    </view>

    <!-- 加入后能做什么 -->
    <view class="glass-card join-intro">
      <text class="join-intro-title">加入后你可以</text>
      <view class="join-feature">
        <view class="join-feature-icon"><van-icon name="records" size="18px" color="#4097a9" /></view>
        <view class="join-feature-text">
          <text class="join-feature-name">一起记账</text>
          <text class="join-feature-desc">公账支出实时同步，账目清晰透明</text>
        </view>
      </view>
      <view class="join-feature">
        <view class="join-feature-icon"><van-icon name="balance-o" size="18px" color="#4097a9" /></view>
        <view class="join-feature-text">
          <text class="join-feature-name">智能分账</text>
          <text class="join-feature-desc">自动计算最优结算，谁付谁还一目了然</text>
        </view>
      </view>
      <view class="join-feature">
        <view class="join-feature-icon"><van-icon name="eye-o" size="18px" color="#4097a9" /></view>
        <view class="join-feature-text">
          <text class="join-feature-name">私账账目</text>
          <text class="join-feature-desc">私账消费仅自己可见，不影响公账分账</text>
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="join-actions">
      <button
        class="btn-primary join-btn {{joining ? 'loading' : ''}}"
        bindtap="onJoin"
        disabled="{{joining}}"
        hover-class="none"
      >
        <view wx:if="{{joining}}" class="btn-loading-icon"></view>
        {{joining ? '加入中...' : '加入账本'}}
      </button>
      <text class="join-cancel" bindtap="onCancel">暂不加入</text>
    </view>
  </view>
</view>

<!-- 新用户授权头像/昵称抽屉 -->
<auth-drawer
  show="{{showAuthDrawer}}"
  default-avatar="{{userAvatar}}"
  default-nickname="{{userNickname}}"
  bind:authorized="onAuthorized"
  bind:close="onAuthClose"
/>
