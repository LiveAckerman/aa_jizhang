<view class="profile-setup-page">
  <nav-bar title="完善信息" show-back="{{false}}">
    <text slot="left" class="nav-action" bindtap="onSkip">跳过</text>
    <text slot="right" class="nav-action nav-action--primary" bindtap="onComplete">完成</text>
  </nav-bar>

  <!-- 内容区 -->
  <view class="content">
    <!-- 提示文字 -->
    <view class="tips">
      <text class="tips-title">让好友更容易识别你</text>
      <text class="tips-desc">上传真实头像和昵称，方便好友快速识别</text>
    </view>

    <!-- 头像上传 -->
    <view class="avatar-section">
      <view class="avatar-container" bindtap="chooseAvatar">
        <image class="avatar" src="{{avatar}}" mode="aspectFill" />
        <view class="avatar-mask" wx:if="{{uploading}}">
          <text class="loading-text">上传中...</text>
        </view>
      </view>
      <text class="avatar-tip">点击上传头像</text>
    </view>

    <!-- 昵称输入 -->
    <view class="nickname-section">
      <view class="input-container">
        <input
          class="nickname-input"
          value="{{nickname}}"
          placeholder="请输入昵称"
          placeholder-class="placeholder"
          maxlength="20"
          bindinput="onNicknameInput"
        />
      </view>
    </view>
  </view>
</view>
