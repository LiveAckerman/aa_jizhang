<view class="add-page">
  <!-- 骨架屏：初始数据加载中 -->
  <block wx:if="{{initLoading}}">
    <view class="sk-tabs">
      <view class="sk-tab"></view>
      <view class="sk-tab"></view>
    </view>
    <view class="sk-amount"></view>
    <view class="glass-card sk-section">
      <view class="sk-label"></view>
      <view class="sk-cat-grid">
        <view wx:for="{{[1,2,3,4,5,6,7,8]}}" wx:key="*this" class="sk-cat-item">
          <view class="sk-cat-icon"></view>
          <view class="sk-cat-name"></view>
        </view>
      </view>
    </view>
    <view class="glass-card sk-section">
      <view class="sk-label"></view>
      <view class="sk-chip-row">
        <view wx:for="{{[1,2,3]}}" wx:key="*this" class="sk-chip"></view>
      </view>
    </view>
    <view class="glass-card sk-section">
      <view class="sk-label"></view>
      <view class="sk-member-row">
        <view wx:for="{{[1,2,3,4]}}" wx:key="*this" class="sk-member-chip"></view>
      </view>
    </view>
    <view class="glass-card sk-row"></view>
    <view class="glass-card sk-row"></view>
    <view class="sk-save-btn"></view>
  </block>

  <block wx:else>
    <transaction-form
      wx:if="{{formReady}}"
      id="txForm"
      members="{{members}}"
      rates="{{rates}}"
      my-user-id="{{myUserId}}"
      initial="{{initial}}"
      autofocus="{{!isEdit}}"
    />

    <button class="btn-primary save-btn" bindtap="onSave" disabled="{{saving}}">
      {{saving ? '保存中...' : '保存'}}
    </button>
    <view wx:if="{{isEdit}}" class="logs-link" bindtap="onOpenLogs">查看修改记录</view>
    <view wx:if="{{isEdit}}" class="delete-link" bindtap="onDelete">删除账单</view>
  </block>
</view>
