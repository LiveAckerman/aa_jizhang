<view class="tab-page">
  <view class="page-header header-row">
    <text class="page-title">账本</text>
    <!-- 搜索框 -->
    <view class="search-box">
      <van-icon name="search" size="16px" color="#8091a5" />
      <input
        class="search-input"
        placeholder="搜索账本"
        placeholder-class="search-input-ph"
        value="{{keyword}}"
        bindinput="onSearch"
        confirm-type="search"
      />
      <van-icon wx:if="{{keyword}}" name="clear" size="16px" color="#c8c9cc" catchtap="onClearSearch" />
    </view>
    <view class="header-add" bindtap="onTapCreate">
      <van-icon name="plus" size="20px" color="#fff" />
    </view>
  </view>

  <!-- 归属筛选：全部 / 我创建的 / 我加入的 -->
  <view class="owner-switch">
    <view class="owner-tab {{ownerFilter === 'all' ? 'active' : ''}}" data-val="all" bindtap="onPickOwner">全部</view>
    <view class="owner-tab {{ownerFilter === 'owned' ? 'active' : ''}}" data-val="owned" bindtap="onPickOwner">我创建的</view>
    <view class="owner-tab {{ownerFilter === 'joined' ? 'active' : ''}}" data-val="joined" bindtap="onPickOwner">我加入的</view>
  </view>

  <!-- 分组筛选 chips -->
  <scroll-view scroll-x="{{true}}" class="group-scroll" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="group-chip {{activeGroupId === 'all' ? 'active' : ''}}" data-id="all" bindtap="onPickGroup">
      <text>全部</text>
    </view>
    <view
      wx:for="{{groups}}"
      wx:key="id"
      class="group-chip {{activeGroupId === (item.isDefault ? 'default' : item.id) ? 'active' : ''}}"
      data-id="{{item.isDefault ? 'default' : item.id}}"
      bindtap="onPickGroup"
      bindlongpress="onLongPressGroup"
    >
      <text>{{item.isDefault ? '默认' : item.name}}</text>
      <text wx:if="{{item.bookCount != null}}" class="group-count">{{item.bookCount}}</text>
    </view>
  </scroll-view>

  <!-- 加载中：骨架屏（3 张卡片） -->
  <view wx:if="{{loading}}" class="book-list">
    <view wx:for="{{[1,2,3]}}" wx:key="*this" class="glass-card book-plain skeleton-card">
      <view class="skeleton-row-1">
        <van-skeleton title="{{true}}" row="{{0}}" title-width="55%" />
        <view class="skeleton-tag"></view>
      </view>
      <view class="skeleton-row-2">
        <view class="skeleton-avatars">
          <view class="skeleton-avatar" wx:for="{{[1,2,3]}}" wx:key="*this" wx:for-item="_"></view>
        </view>
        <view class="skeleton-date"></view>
      </view>
      <view class="skeleton-divider"></view>
      <view class="skeleton-row-3">
        <van-skeleton row="{{1}}" row-width="140rpx" />
        <view class="skeleton-more"></view>
      </view>
    </view>
  </view>

  <!-- 空状态：真正没有账本 -->
  <view wx:elif="{{books.length === 0}}" class="empty-state">
    <image class="empty-illustration" src="https://cdn.ljw44.com/assets/illustrations/empty-book.png" mode="aspectFit" />
    <text class="empty-title">还没有账本</text>
    <text class="empty-desc">创建第一个账本，开始和朋友一起记账</text>
    <button class="btn-primary create-btn" bindtap="onTapCreate">创建账本</button>
  </view>

  <!-- 空状态：有账本但搜索/归属筛选结果为空 -->
  <view wx:elif="{{filteredEmpty}}" class="empty-state">
    <van-icon name="search" size="64px" color="#c8c9cc" />
    <block wx:if="{{keyword}}">
      <text class="empty-title">没有找到「{{keyword}}」</text>
      <text class="empty-desc">试试其他关键词，或清除搜索</text>
      <button class="btn-outline clear-search-btn" bindtap="onClearSearch">清除搜索</button>
    </block>
    <block wx:else>
      <text class="empty-title">{{ownerFilter === 'owned' ? '还没有我创建的账本' : '还没有我加入的账本'}}</text>
      <text class="empty-desc">{{ownerFilter === 'owned' ? '点击右上角 + 创建一个账本' : '通过邀请码或扫码加入好友的账本'}}</text>
    </block>
  </view>

  <!-- 账本列表 -->
  <view wx:elif="{{active.length > 0 || archived.length > 0}}" class="book-list">
    <!-- 进行中 -->
    <block wx:for="{{active}}" wx:key="id" wx:for-item="book">
      <!-- 布局1：有自定义封面 → 头图卡片 -->
      <view wx:if="{{book.hasCover}}" class="glass-card book-item">
        <view class="book-tap-area" data-id="{{book.id}}" bindtap="onTapBook">
          <image class="book-cover" src="{{book.coverUrl}}" mode="aspectFill" />
          <view class="book-body">
            <view class="book-row">
              <text class="book-name">{{book.name}}</text>
              <text class="book-member-count">{{book.memberCount}}人</text>
            </view>
            <view class="book-avatars">
              <image
                wx:for="{{book.memberAvatars}}"
                wx:for-item="av"
                wx:key="*this"
                class="book-avatar"
                src="{{av}}"
                mode="aspectFill"
              />
            </view>
            <view class="book-cover-amount">
              <view class="amount-inline">
                <text class="amount-label">支出</text>
                <text class="book-plain-amount">¥{{book.myTotalText}}</text>
                <view wx:if="{{book.hasPrivate}}" class="amount-tags">
                  <text class="amount-tag">公账 ¥{{book.mySharedText}}</text>
                  <text class="amount-tag private">私账 ¥{{book.myPrivateText}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
        <view class="book-corner">
          <book-menu book="{{book}}" is-owner="{{book.isOwner}}" bind:action="onBookAction" />
        </view>
      </view>

      <!-- 布局2：无自定义封面 → 简洁白底卡片 -->
      <view wx:else class="glass-card book-plain">
        <view class="book-plain-tap" data-id="{{book.id}}" bindtap="onTapBook">
          <view class="book-plain-top">
            <text class="book-name">{{book.name}}</text>
            <text class="book-plain-tag">{{book.memberCount}}人</text>
          </view>
          <view class="book-plain-mid">
            <view class="book-avatars">
              <image
                wx:for="{{book.memberAvatars}}"
                wx:for-item="av"
                wx:key="*this"
                class="book-avatar"
                src="{{av}}"
                mode="aspectFill"
              />
              <view class="book-avatar book-invite-btn">
                <van-icon name="plus" size="16px" color="#4097a9" />
              </view>
            </view>
            <text class="book-plain-date">{{book.dateText}}</text>
          </view>
          <view class="book-plain-bottom">
            <view class="amount-inline">
              <text class="amount-label">支出</text>
              <text class="book-plain-amount">¥{{book.myTotalText}}</text>
              <view wx:if="{{book.hasPrivate}}" class="amount-tags">
                <text class="amount-tag">公账 ¥{{book.mySharedText}}</text>
                <text class="amount-tag private">私账 ¥{{book.myPrivateText}}</text>
              </view>
            </view>
            <text class="book-plain-more">统计 ›</text>
          </view>
        </view>
        <view class="book-corner">
          <book-menu book="{{book}}" is-owner="{{book.isOwner}}" bind:action="onBookAction" />
        </view>
      </view>
    </block>

    <!-- 已归档：卡片堆叠（复用 book-plain 外观，负 margin 层叠，只露标题行） -->
    <block wx:if="{{archivedStack.length > 0}}">
      <view class="archived-stack" bindtap="onOpenArchivedDrawer">
        <view
          wx:for="{{archivedStack}}"
          wx:key="id"
          wx:for-item="book"
          class="glass-card book-plain archived-card {{index === 0 ? 'first' : ''}}"
        >
          <view class="book-plain-top">
            <text class="book-name">{{book.name}}</text>
            <text class="archived-badge">已结算</text>
          </view>
          <view class="archived-card-meta">
            <text class="archived-meta-text">{{book.memberCount}}人 · {{book.dateText}} · ¥{{book.myTotalText}}</text>
          </view>
        </view>
        <!-- 空卡片：垫在真实卡片下方，只露出一条边，暗示还有更多 -->
        <view
          wx:for="{{archivedGhost}}"
          wx:key="*this"
          wx:for-item="g"
          class="archived-ghost archived-ghost-{{index}}"
        ></view>
      </view>
      <!-- 点击提示 -->
      <view class="archived-hint" bindtap="onOpenArchivedDrawer">
        <van-icon name="records" size="14px" color="#8091a5" />
        <text>{{archived.length}} 个已结算账本</text>
        <van-icon name="arrow" size="14px" color="#8091a5" />
      </view>
    </block>
  </view>
</view>

<!-- 已归档账本抽屉 -->
<view wx:if="{{showArchivedDrawer}}" class="drawer-mask" bindtap="onCloseArchivedDrawer">
  <view class="drawer-panel" catchtap>
    <view class="drawer-header">
      <view class="drawer-handle"></view>
      <text class="drawer-title">已结算账本（{{archived.length}}）</text>
      <van-icon name="cross" size="20px" color="#8091a5" bindtap="onCloseArchivedDrawer" />
    </view>
    <scroll-view scroll-y class="drawer-scroll">
      <view
        wx:for="{{archived}}"
        wx:key="id"
        wx:for-item="book"
        class="glass-card drawer-book-item"
        data-id="{{book.id}}"
        bindtap="onTapBook"
      >
        <image wx:if="{{book.hasCover}}" class="drawer-book-cover" src="{{book.coverUrl}}" mode="aspectFill" />
        <view class="drawer-book-info">
          <text class="drawer-book-name">{{book.name}}</text>
          <text class="drawer-book-meta">{{book.memberCount}}人 · {{book.dateText}}</text>
          <text class="drawer-book-amount">¥{{book.myTotalText}}</text>
        </view>
        <view class="drawer-book-menu" catchtap="noop">
          <book-menu book="{{book}}" is-owner="{{book.isOwner}}" bind:action="onBookAction" />
        </view>
      </view>
    </scroll-view>
  </view>
</view>

<!-- 首次登录：头像昵称授权抽屉 -->
<auth-drawer
  show="{{showAuthDrawer}}"
  default-avatar="{{userAvatar}}"
  default-nickname="{{userNickname}}"
  bind:authorized="onAuthorized"
  bind:close="onAuthClose"
/>
