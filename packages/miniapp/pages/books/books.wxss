.page-header {
  padding: 24rpx 0 32rpx;
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}

.empty-illustration {
  width: 400rpx;
  height: 320rpx;
  margin-bottom: 48rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 64rpx;
}

.create-btn {
  width: 400rpx;
  height: 96rpx;
  line-height: 96rpx;
}

/* 账本列表 */
.book-item {
  padding: 40rpx;
  margin-bottom: 24rpx;
}

.book-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}
