/* 一级页面专属：青色圆点背景 */
page {
  background-color: #ffffff;
  background-image: radial-gradient(#7ec8d3 1px, transparent 1px);
  background-size: 16px 16px;
}

.page-header {
  padding: 24rpx 0 32rpx;
}

/* 归属筛选分段控件：全部 / 我创建的 / 我加入的 */
.owner-switch {
  display: flex;
  background: rgba(64, 151, 169, 0.08);
  border-radius: 48rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.owner-tab {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
}

.owner-tab.active {
  background: var(--color-primary);
  color: #fff;
  font-weight: 600;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  flex-shrink: 0;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}

.empty-illustration {
  width: 400rpx;
  height: 320rpx;
  margin-bottom: 48rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 64rpx;
}

.create-btn {
  width: 400rpx;
  height: 96rpx;
  line-height: 96rpx;
}

/* header 右侧加号 */
.header-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.header-add {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(64, 151, 169, 0.35);
}

/* 账本列表 */
.book-list {
  display: flex;
  flex-direction: column;
}

.book-item {
  margin-bottom: 24rpx;
  overflow: hidden;
  padding: 0;
}

.book-item.archived {
  opacity: 0.7;
}

.book-cover {
  width: 100%;
  height: 220rpx;
  display: block;
}

.book-body {
  padding: 28rpx 32rpx 32rpx;
  position: relative;
  overflow: hidden;
}

/* 封面卡片白色区水印装饰，与无封面卡片统一 */
.book-body::after {
  content: '';
  position: absolute;
  right: 0;
  bottom: 0;
  width: 320rpx;
  height: 320rpx;
  background-image: url('https://cdn.ljw44.com/images/2026-08/card-watermark.webp');
  background-size: contain;
  background-repeat: no-repeat;
  background-position: right bottom;
  opacity: 0.12;
  pointer-events: none;
  z-index: 0;
}

.book-body .book-row,
.book-body .book-avatars,
.book-body .book-cover-amount {
  position: relative;
  z-index: 1;
}

.book-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.book-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.book-member-count {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.book-avatars {
  display: flex;
  margin-top: 16rpx;
}

.book-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  border: 2rpx solid #fff;
  margin-right: -12rpx;
  background: #eee;
}

.group-title {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin: 24rpx 8rpx 16rpx;
}

/* 分组筛选 chips */
.group-scroll {
  white-space: nowrap;
  margin-bottom: 24rpx;
  padding-bottom: 8rpx;
}

.group-chip {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 36rpx;
  background: #fff;
  font-size: 26rpx;
  color: var(--text-primary);
  box-shadow: 0 4rpx 16rpx rgba(47, 65, 89, 0.06);
}

.group-chip.active {
  background: var(--color-primary);
  color: #fff;
}

.group-count {
  margin-left: 10rpx;
  font-size: 22rpx;
  opacity: 0.72;
}

/* 卡片右上角菜单 */
.book-item,
.book-plain {
  position: relative;
}

.book-corner {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  z-index: 2;
}

.book-tap-area {
  display: block;
}

/* 简洁白底卡片（无自定义封面） */
.book-plain {
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
}

/* 卡片水印装饰：淡色记账元素铺在右下，不抢内容 */
.book-plain::after {
  content: '';
  position: absolute;
  right: 0;
  bottom: 0;
  width: 320rpx;
  height: 320rpx;
  background-image: url('https://cdn.ljw44.com/images/2026-08/card-watermark.webp');
  background-size: contain;
  background-repeat: no-repeat;
  background-position: right bottom;
  opacity: 0.12;
  pointer-events: none;
  z-index: 0;
}

/* 内容层提到水印之上 */
.book-plain-tap {
  display: block;
  position: relative;
  z-index: 1;
}

.book-plain-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-right: 72rpx; /* 留右上角菜单位 */
}

.book-plain-tag {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(64, 151, 169, 0.12);
  font-size: 22rpx;
  color: var(--color-primary);
}

.book-plain-mid {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.book-plain-date {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.book-invite-btn {
  background: rgba(64, 151, 169, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.book-plain-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid rgba(128, 145, 165, 0.14);
}

.book-plain-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.book-plain-amount {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.book-plain-more {
  font-size: 26rpx;
  color: var(--color-primary);
}

/* 金额行（两种卡片共用，单行紧凑） */
.amount-inline {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.amount-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.book-plain-amount {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.2;
}

.amount-tags {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-left: 4rpx;
}

.amount-tag {
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  background: rgba(64, 151, 169, 0.10);
  color: var(--color-primary);
}

.amount-tag.private {
  background: rgba(128, 145, 165, 0.14);
  color: var(--text-secondary);
}

/* 带封面卡片：金额行在头像下面 */
.book-cover-amount {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid rgba(128, 145, 165, 0.14);
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

/* ============ 骨架屏 ============ */
.skeleton-cover-card {
  height: 300rpx;
  border-radius: 32rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #d8dde6, #c8cfd8);
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 28rpx;
  box-sizing: border-box;
  animation: skeleton-blink 1.2s ease-in-out infinite;
}

.skeleton-cover-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.skeleton-cover-bottom {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.skeleton-cover-name {
  width: 200rpx;
  height: 32rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.45);
}

.skeleton-cover-amount {
  width: 260rpx;
  height: 52rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.45);
}

.skeleton-cover-sub {
  width: 320rpx;
  height: 24rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.3);
}

.skeleton-menu-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.3);
}

.skeleton-avatars {
  display: flex;
}

.skeleton-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.45);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  margin-right: -14rpx;
}

@keyframes skeleton-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* 搜索框 */
.search-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 24rpx;
  height: 68rpx;
  background: #fff;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(47, 65, 89, 0.06);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.search-input-ph {
  color: #8091a5;
}

/* 清除搜索按钮 */
.clear-search-btn {
  margin-top: 32rpx;
  padding: 0 48rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: 40rpx;
  font-size: 28rpx;
}

.clear-search-btn::after {
  border: none;
}

/* ── 已归档卡片堆叠 ── */
/* ── 已结算账本：card-stack slot 内容样式 ── */
/* 折叠态顶部卡片：清零底边距，紧贴影子卡 */
.cs-top-book {
  margin-bottom: 0;
}
/* 折叠态顶部卡片的副标题行 */
.archived-card-meta {
  margin-top: 8rpx;
}
.archived-meta-text {
  font-size: 22rpx;
  color: var(--text-secondary);
}
.archived-badge {
  font-size: 22rpx;
  color: var(--text-secondary);
  background: rgba(128, 145, 165, 0.12);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

/* 展开态列表项 */
.drawer-book-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.drawer-book-cover {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.drawer-book-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.drawer-book-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.drawer-book-meta {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.drawer-book-amount {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-accent);
}

.drawer-book-menu {
  flex-shrink: 0;
}
