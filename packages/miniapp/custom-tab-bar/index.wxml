<view class="tabbar-wrap" wx:if="{{!hide}}">
  <view class="tabbar glass">
    <!-- 滑动高亮 pill：通过 translateX 定位到激活项。noAnim 时禁用过渡（用于瞬移到起点） -->
    <view
      class="pill {{noAnim ? 'no-anim' : ''}}"
      style="width: {{100 / list.length}}%; transform: translateX({{pillIndex * 100}}%);"
    >
      <view class="pill-inner"></view>
    </view>

    <!-- tab 项 -->
    <view
      wx:for="{{list}}"
      wx:key="key"
      class="tab-item {{selected === index ? 'active' : ''}}"
      data-index="{{index}}"
      bindtap="onTap"
    >
      <view class="tab-icon icon-{{item.key}}"></view>
      <text class="tab-text">{{item.text}}</text>
    </view>
  </view>
</view>
