/* 外层：固定底部，左右+底部留间距，悬浮式 */
.tabbar-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  /* 底部留出安全区 + 间距 */
  padding: 0 32rpx calc(env(safe-area-inset-bottom) + 24rpx);
  z-index: 999;
  pointer-events: none;
}

/* 快速记账悬浮按钮：悬在导航条右上角外侧，避免压住 tab */
.fab {
  position: absolute;
  /* wrap 左右 padding 32rpx；再往内 8rpx，让按钮贴住导航条右端外沿 */
  right: 24rpx;
  /* 导航条高度120 + 底部安全区 + 间距，使按钮整体上移到导航条上方 */
  bottom: calc(120rpx + env(safe-area-inset-bottom) + 40rpx);
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #4097a9, #5fb5c4);
  box-shadow: 0 12rpx 32rpx rgba(64, 151, 169, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
  z-index: 1000;
}
.fab:active {
  transform: scale(0.94);
}
/* "+" 号：用两条白色线拼，避免依赖图标库 */
.fab-icon {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}
.fab-icon::before,
.fab-icon::after {
  content: '';
  position: absolute;
  background: #fff;
  border-radius: 4rpx;
}
.fab-icon::before {
  left: 50%;
  top: 0;
  width: 6rpx;
  height: 100%;
  transform: translateX(-50%);
}
.fab-icon::after {
  top: 50%;
  left: 0;
  height: 6rpx;
  width: 100%;
  transform: translateY(-50%);
}

/* 磨砂玻璃导航条 */
.tabbar {
  position: relative;
  display: flex;
  align-items: center;
  height: 120rpx;
  border-radius: 60rpx;
  pointer-events: auto;
  overflow: hidden;
}

/* 实白底导航条 */
.glass {
  background: #ffffff;
  border: 1rpx solid rgba(128, 145, 165, 0.12);
  box-shadow: 0 16rpx 48rpx rgba(47, 65, 89, 0.16);
}

/* 滑动高亮 pill：绝对定位，transform 平滑滑动 */
.pill {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  /* 关键：弹性缓动，切换时"弹"过去 */
  transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

/* 瞬移到起点时禁用动画 */
.pill.no-anim {
  transition: none;
}

/* pill 内部真正的高亮胶囊（约占单格 2/3 宽，居中） */
.pill-inner {
  width: 67%;
  height: 88rpx;
  border-radius: 44rpx;
  background: rgba(64, 151, 169, 0.14);
  border: 1rpx solid rgba(64, 151, 169, 0.2);
}

/* tab 项 */
.tab-item {
  position: relative;
  z-index: 2;
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

/* 图标：用 mask 实现单色矢量图标，颜色由 background-color 控制 */
.tab-icon {
  width: 44rpx;
  height: 44rpx;
  background-color: #8091a5;
  transition: background-color 0.3s ease, transform 0.3s ease;
}

/* 文字 */
.tab-text {
  font-size: 22rpx;
  color: #8091a5;
  transition: color 0.3s ease;
  line-height: 1;
}

/* 激活态：图标和文字变品牌色 */
.tab-item.active .tab-icon {
  background-color: #4097a9;
  transform: scale(1.05);
}

.tab-item.active .tab-text {
  color: #4097a9;
  font-weight: 600;
}

/* ===== 矢量图标（SVG mask，颜色由 background-color 控制）===== */

