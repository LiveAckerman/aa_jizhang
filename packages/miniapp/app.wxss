/**
 * 全局样式 - 一起分账吧
 * 品牌色 + Apple 磨砂玻璃通用类
 */

page {
  /* 品牌色变量 */
  --color-primary: #4097a9;
  --color-secondary: #f4dfcc;
  --color-accent: #fa9583;
  --color-dark: #2f4159;
  --color-wechat: #07c160;

  /* 文字层级 */
  --text-primary: #2f4159;
  --text-secondary: #8091a5;
  --text-tertiary: #c4c4c4;

  /* 背景 */
  --bg-page: #ffffff;
  --bg-card: rgba(255, 255, 255, 0.85);

  /* 圆点网格背景（亮色系）：改这几个变量即可全局调整 */
  --dot-color: #e5e7eb;   /* 圆点颜色，想更明显可调深如 #d1d5db */
  --dot-size: 1px;        /* 圆点大小 */
  --dot-gap: 16px;        /* 网格间距，越大越疏 */

  /* 全局圆点背景：radial-gradient 当可平铺图案，按网格平铺 */
  background-color: var(--bg-page);
  background-image: radial-gradient(var(--dot-color) var(--dot-size), transparent var(--dot-size));
  background-size: var(--dot-gap) var(--dot-gap);
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.5;
}

/* 全局 button 重置：修复真机文字不居中 + 覆盖原生样式 */
button {
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  border: none;
}

button::after {
  border: none;
  background: none;
}

/* 覆盖微信默认的 button-hover */
button.button-hover {
  opacity: 0.9;
}

/* 自定义按钮组件外层：默认占满宽度 */
primary-button {
  display: block;
  width: 100%;
}

/* 磨砂玻璃卡片通用类 */
.glass-card {
  background: var(--bg-card);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 32rpx;
  box-shadow: 0 16rpx 64rpx rgba(47, 65, 89, 0.08);
}

/* 主按钮 - 使用 button 元素选择器提高优先级 */
button.btn-primary {
  background-color: #fa9583 !important;
  background: #fa9583 !important;
  color: #ffffff !important;
  border-radius: 48rpx !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
  border: none !important;
  position: relative !important;
  overflow: visible !important;
}

/* 强制覆盖所有可能的状态 */
button.btn-primary::before,
button.btn-primary::after {
  background: transparent !important;
  border: none !important;
  display: none !important;
}

/* 按钮按下态：防止变白 */
button.btn-primary:active,
button.btn-primary:hover,
button.btn-primary:focus {
  opacity: 0.8 !important;
  background-color: #fa9583 !important;
  background: #fa9583 !important;
  color: #ffffff !important;
}

/* 按钮禁用态 */
button.btn-primary:disabled,
button.btn-primary[disabled],
button.btn-primary[disabled]:active {
  opacity: 0.6 !important;
  background-color: #fa9583 !important;
  background: #fa9583 !important;
  color: #ffffff !important;
}

/* 按钮 loading 状态 */
button.btn-primary.loading,
button.btn-primary.loading:active {
  opacity: 0.8 !important;
  background-color: #fa9583 !important;
  background: #fa9583 !important;
  color: #ffffff !important;
}

/* 覆盖 button-hover 类（微信默认） */
button.btn-primary.button-hover {
  opacity: 0.8 !important;
  background-color: #fa9583 !important;
  background: #fa9583 !important;
  color: #ffffff !important;
}

/* 按钮内 loading icon */
.btn-loading-icon {
  display: inline-block;
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  vertical-align: -6rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: btn-rotate 0.6s linear infinite;
}

@keyframes btn-rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 通用容器 */
.container {
  padding: 32rpx;
  box-sizing: border-box;
}

/* tab 页容器：底部留出悬浮 nav 的空间（nav 高度 120 + 间距 24 + 安全区） */
.tab-page {
  padding: 32rpx 32rpx calc(200rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* flex 工具类 */
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}
