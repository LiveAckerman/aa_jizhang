<view class="batch-page">

  <!-- 顶部区域：缩略图 + 进度 + 翻页 -->
  <view class="top-bar" wx:if="{{records.length > 0}}">
    <view class="top-left">
      <!-- OCR 原图缩略图，带×关闭（设计图左上角） -->
      <view class="thumb-wrap" wx:if="{{ocrImageUrl}}">
        <image class="thumb-img" src="{{ocrImageUrl}}" mode="aspectFill" bindtap="onPreviewImage" />
        <view class="thumb-close" catchtap="onExit">
          <van-icon name="cross" size="14px" color="#fff" />
        </view>
      </view>
      <!-- 识别结果 + 进度 + 重新上传 -->
      <view class="top-meta">
        <text class="top-title">识别结果</text>
        <!-- 进度：当前在剩余记录中的位置（翻页/删除都能正确反映） -->
        <text class="top-progress">{{current + 1}}/{{records.length}}</text>
        <view class="reupload-btn" catchtap="onReupload">
          <van-icon name="replay" size="14px" color="#4097a9" />
          <text class="reupload-text">重新上传</text>
        </view>
      </view>
    </view>
    <!-- 右侧翻页箭头 -->
    <view class="top-pager">
      <view
        class="pager-arrow {{current === 0 ? 'disabled' : ''}}"
        catchtap="onPrev"
      >
        <van-icon name="arrow-left" size="20px" color="{{current === 0 ? '#c4c4c4' : '#4097a9'}}" />
      </view>
      <view
        class="pager-arrow {{current === records.length - 1 ? 'disabled' : ''}}"
        catchtap="onNext"
      >
        <van-icon name="arrow" size="20px" color="{{current === records.length - 1 ? '#c4c4c4' : '#4097a9'}}" />
      </view>
    </view>
  </view>

  <!-- 表单主体：每条记录一个 transaction-form -->
  <block wx:if="{{records.length > 0}}">
    <view wx:for="{{records}}" wx:key="id" class="form-wrap" hidden="{{current !== index}}">
      <transaction-form
        id="form_{{item.id}}"
        members="{{members}}"
        rates="{{rates}}"
        my-user-id="{{myUserId}}"
        book-id="{{bookId}}"
        initial="{{item.initial}}"
      />
    </view>

    <!-- 底部操作栏：垃圾桶 / 确认提交 / 跳过 -->
    <view class="bottom-bar">
      <view class="bar-row">
        <!-- 左：垃圾桶（带角标，空时置灰不可点） -->
        <view class="trash-btn {{trashed.length === 0 ? 'disabled' : ''}}" catchtap="onOpenTrash">
          <van-icon name="delete-o" size="24px" color="{{trashed.length === 0 ? '#c4c4c4' : '#fa9583'}}" />
          <view wx:if="{{trashed.length > 0}}" class="trash-badge">{{trashed.length}}</view>
        </view>
        <!-- 中：确认提交 -->
        <button
          class="btn-submit"
          bindtap="onSubmit"
          disabled="{{submitting}}"
        >{{submitting ? '提交中...' : '确认提交'}}</button>
        <!-- 右：跳过当前条 -->
        <view class="skip-btn" catchtap="onSkipCurrent">
          <text>跳过</text>
        </view>
      </view>
    </view>
  </block>

  <!-- 空态 -->
  <view wx:elif="{{ready}}" class="empty-state">
    <van-icon name="checked" size="64px" color="#52c41a" />
    <text class="empty-title">全部处理完成</text>
    <button class="btn-back" bindtap="onBack">返回账本</button>
  </view>

  <!-- 加载中 -->
  <view wx:else class="loading-state">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 垃圾桶抽屉：已跳过的记录，可恢复 -->
  <view wx:if="{{showTrash}}" class="trash-mask" catchtap="onCloseTrash">
    <view class="trash-panel" catchtap="stopPropagation">
      <view class="trash-panel-header">
        <text class="trash-panel-title">已跳过（{{trashed.length}}）</text>
        <van-icon name="cross" size="18px" color="#8091a5" catchtap="onCloseTrash" />
      </view>
      <text class="trash-panel-sub">点击「恢复」可重新编辑并提交</text>
      <scroll-view scroll-y class="trash-list">
        <view wx:for="{{trashed}}" wx:key="id" class="trash-item">
          <view class="trash-item-main">
            <text class="trash-item-note">{{item.initial.note || '未填写备注'}}</text>
            <text class="trash-item-amount">¥{{item.initial.amount}}</text>
          </view>
          <view class="trash-item-restore" data-id="{{item.id}}" catchtap="onRestore">
            <van-icon name="replay" size="14px" color="#4097a9" />
            <text>恢复</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

</view>
