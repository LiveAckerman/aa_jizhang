.batch-page {
  min-height: 100vh;
  background: #f2f2f7;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ── 顶部区域 ── */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 20rpx;
  background: #fff;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.top-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

/* 缩略图 */
.thumb-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
}
.thumb-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: #eee;
}
.thumb-close {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 缩略图数量角标（多图时显示，右下角） */
.thumb-count {
  position: absolute;
  bottom: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #4097a9;
  color: #fff;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.2);
}

/* 识别结果 meta */
.top-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}
.top-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111;
}
.top-progress {
  font-size: 24rpx;
  color: #8e9aad;
  margin-left: 10rpx;
}
.reupload-btn {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  border: 2rpx solid #4097a9;
  border-radius: 32rpx;
  width: fit-content;
}
.reupload-text {
  font-size: 24rpx;
  color: #4097a9;
}

/* 右侧翻页 */
.top-pager {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}
.pager-arrow {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #f0f5f6;
  border: 1rpx solid rgba(64, 151, 169, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}
.pager-arrow.disabled {
  opacity: 0.4;
}

/* ── 表单包裹：左右边距 ── */
.form-wrap {
  padding: 0 32rpx;
}

/* ── 底部操作栏 ── */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 24rpx rgba(47, 65, 89, 0.07);
}

/* 三按钮一行：垃圾桶 / 确认提交 / 跳过 */
.bar-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

/* 左：垃圾桶按钮 */
.trash-btn {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: rgba(250, 149, 131, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.trash-btn.disabled {
  background: rgba(128, 145, 165, 0.08);
}
.trash-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #fa5151;
  color: #fff;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
}

/* 中：确认提交（占满剩余宽度） */
.btn-submit {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  background: #4097a9;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  letter-spacing: 2rpx;
  margin: 0;
}
.btn-submit[disabled] {
  opacity: 0.55;
}
.btn-submit::after { border: none; }

/* 右：跳过按钮（描边样式，明确可点击，区别于禁用灰） */
.skip-btn {
  width: 128rpx;
  height: 96rpx;
  box-sizing: border-box;
  border-radius: 48rpx;
  background: #fff;
  border: 2rpx solid #4097a9;
  color: #4097a9;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.skip-btn:active {
  background: rgba(64, 151, 169, 0.08);
}

/* ── 空态 ── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  gap: 28rpx;
}
.empty-title {
  font-size: 30rpx;
  color: #52c41a;
  font-weight: 600;
}
.empty-title-warn {
  color: #fa9583;
}
.empty-sub {
  font-size: 26rpx;
  color: #8e9aad;
  margin-top: -12rpx;
}
.empty-actions {
  display: flex;
  gap: 24rpx;
  align-items: center;
}
.btn-reupload {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 48rpx;
  border-radius: 44rpx;
  background: #fff !important;
  color: #4097a9 !important;
  font-size: 28rpx;
  border: 2rpx solid #4097a9 !important;
}
.btn-reupload::after { border: none; }
.btn-back {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 64rpx;
  border-radius: 44rpx;
  background: #4097a9 !important;
  color: #fff !important;
  font-size: 28rpx;
  border: none !important;
}
.btn-back::after { border: none; }

/* ── 加载中 ── */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
  gap: 24rpx;
}
.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid #e3e8ef;
  border-top-color: #4097a9;
  border-radius: 50%;
  animation: ocr-spin 0.8s linear infinite;
}
.loading-text {
  font-size: 28rpx;
  color: #8e9aad;
}
.loading-sub {
  font-size: 24rpx;
  color: #b3bccb;
}
@keyframes ocr-spin {
  to { transform: rotate(360deg); }
}

/* ── 后台串行识别进度条 ── */
.batch-progress {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 24rpx 16rpx;
  padding: 14rpx 20rpx;
  background: rgba(64, 151, 169, 0.1);
  border-radius: 16rpx;
}
.batch-progress-spinner {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid rgba(64, 151, 169, 0.3);
  border-top-color: #4097a9;
  border-radius: 50%;
  flex-shrink: 0;
  animation: ocr-spin 0.8s linear infinite;
}
.batch-progress-text {
  font-size: 24rpx;
  color: #4097a9;
}

/* ── 垃圾桶抽屉 ── */
.trash-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  width: 100vw;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1001;
  display: flex;
  align-items: flex-end;
}
.trash-panel {
  width: 100vw;
  box-sizing: border-box;
  background: #f5f6fa;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}
.trash-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.trash-panel-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.trash-panel-sub {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
  display: block;
}
.trash-list {
  max-height: 640rpx;
  margin-top: 24rpx;
}
.trash-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.trash-item-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.trash-item-note {
  font-size: 28rpx;
  color: var(--text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.trash-item-amount {
  font-size: 26rpx;
  font-weight: 600;
  color: #fa9583;
}
.trash-item-restore {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  background: rgba(64, 151, 169, 0.1);
  color: #4097a9;
  font-size: 26rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}
