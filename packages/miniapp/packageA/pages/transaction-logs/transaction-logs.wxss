.logs-page {
  padding: 24rpx 32rpx;
}

.logs-empty {
  text-align: center;
  color: var(--text-secondary);
  padding: 120rpx 0;
  font-size: 28rpx;
}

.log-item {
  display: flex;
  align-items: flex-start;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}

.log-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: #eee;
  flex-shrink: 0;
}

.log-body {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.log-user {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.log-lines {
  display: flex;
  flex-direction: column;
  margin-top: 8rpx;
}

.log-line {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.log-time {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* 骨架屏 */
.sk-avatar,
.sk-line {
  background: #eef0f2;
  animation: sk-blink 1.2s ease-in-out infinite;
}
@keyframes sk-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}
.sk-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  flex-shrink: 0;
}
.sk-line {
  border-radius: 8rpx;
  height: 24rpx;
}
.sk-user { width: 140rpx; height: 28rpx; margin-bottom: 12rpx; }
.sk-l1 { width: 100%; margin-bottom: 10rpx; }
.sk-l2 { width: 70%; }
.sk-date { width: 90rpx; height: 20rpx; }
.sk-time { width: 70rpx; height: 20rpx; }
