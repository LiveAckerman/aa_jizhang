<!-- 人员卡片模板：含展开明细 + 已结算按钮 -->
<template name="person-card">
  <view class="glass-card person-card">
    <view class="person-head">
      <image class="person-avatar" src="{{item.avatar}}" mode="aspectFill" />
      <view class="person-info">
        <text class="person-name">{{item.nickname}}</text>
        <text class="person-amount {{kind}}">{{kind === 'receive' ? '需转你' : '需付'}} ¥{{item.netAmountText}}</text>
      </view>
      <!-- 待收款：两按钮竖排（提醒 TA + 已结算） -->
      <view wx:if="{{kind === 'receive'}}" class="person-actions">
        <button class="settle-btn remind-btn" data-id="{{item.otherUserId}}" data-name="{{item.nickname}}" data-amount="{{item.netAmountText}}" open-type="share" catchtap="onRemind">
          <van-icon name="chat-o" size="14px" color="#4097a9" />
          <text>提醒 TA</text>
        </button>
        <button class="settle-btn" data-id="{{item.otherUserId}}" data-name="{{item.nickname}}" catchtap="onSettle">
          <van-icon name="passed" size="14px" color="#fff" />
          <text>已结算</text>
        </button>
      </view>
      <!-- 待支付：只有「已结算」按钮 -->
      <button wx:else class="settle-btn" data-id="{{item.otherUserId}}" data-name="{{item.nickname}}" catchtap="onSettle">
        <van-icon name="passed" size="14px" color="#fff" />
        <text>已结算</text>
      </button>
    </view>
    <view class="expand-toggle" data-id="{{item.otherUserId}}" bindtap="onToggleExpand">
      <text>{{expandedMap[item.otherUserId] ? '收起明细' : '展开明细（' + item.details.length + '笔）'}}</text>
      <van-icon name="{{expandedMap[item.otherUserId] ? 'arrow-up' : 'arrow-down'}}" size="12px" color="#8091a5" />
    </view>
    <view wx:if="{{expandedMap[item.otherUserId]}}" class="detail-list">
      <view wx:for="{{item.details}}" wx:for-item="d" wx:key="txId" class="detail-item">
        <view class="detail-icon"><image wx:if="{{d.categorySvg}}" class="detail-icon-svg" src="{{d.categorySvg}}" mode="aspectFit" /><van-icon wx:else name="{{d.categoryIcon}}" size="18px" color="#4097a9" /></view>
        <view class="detail-mid">
          <text class="detail-cat">{{d.categoryName}}</text>
          <text class="detail-note">{{d.note || d.dateText}}</text>
        </view>
        <view class="detail-right">
          <text class="detail-dir {{d.isTheyOwe ? 'in' : 'out'}}">{{d.isTheyOwe ? '+' : '-'}}¥{{d.amountText}}</text>
          <text class="detail-date">{{d.dateText}}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<!-- 待支付 section -->
<template name="pay-section">
  <!-- 全部 tab 下:有数据才显示 header;单独 tab 总是显示 header -->
  <view wx:if="{{withHeader && (showEmpty || payables.length > 0)}}" class="section-header-bar">
    <van-icon name="cart-o" size="16px" color="#fa9583" />
    <text class="section-header-title pay">待支付</text>
  </view>
  <!-- 空态:单独 tab(showEmpty=true)总是显示;全部 tab(showEmpty=false)下无数据就不显示这块 -->
  <view wx:if="{{payables.length === 0 && showEmpty}}" class="empty-state">
    <van-icon name="notes-o" size="48px" color="#d9d9d9" />
    <text class="empty-text">暂无待支付</text>
  </view>
  <view wx:for="{{payables}}" wx:key="otherUserId">
    <template is="person-card" data="{{item, kind: 'pay', expandedMap}}" />
  </view>
</template>

<!-- 待收款 section -->
<template name="receive-section">
  <!-- 全部 tab 下:有数据才显示 header;单独 tab 总是显示 header -->
  <view wx:if="{{withHeader && (showEmpty || receivables.length > 0)}}" class="section-header-bar">
    <van-icon name="balance-o" size="16px" color="#4097a9" />
    <text class="section-header-title receive">待收款</text>
  </view>
  <!-- 空态:单独 tab(showEmpty=true)总是显示;全部 tab(showEmpty=false)下无数据就不显示这块 -->
  <view wx:if="{{receivables.length === 0 && showEmpty}}" class="empty-state">
    <van-icon name="notes-o" size="48px" color="#d9d9d9" />
    <text class="empty-text">暂无待收款</text>
  </view>
  <view wx:for="{{receivables}}" wx:key="otherUserId">
    <template is="person-card" data="{{item, kind: 'receive', expandedMap}}" />
  </view>
</template>

<!-- 已结算 section -->
<template name="settled-section">
  <!-- 全部 tab 下:有数据才显示 header;单独 tab 总是显示 header -->
  <view wx:if="{{withHeader && (showEmpty || settledList.length > 0)}}" class="section-header-bar">
    <van-icon name="passed" size="16px" color="#52c41a" />
    <text class="section-header-title settled">已结算</text>
  </view>
  <!-- 空态:单独 tab(showEmpty=true)总是显示;全部 tab(showEmpty=false)下无数据就不显示这块 -->
  <view wx:if="{{settledList.length === 0 && showEmpty}}" class="empty-state">
    <van-icon name="notes-o" size="48px" color="#d9d9d9" />
    <text class="empty-text">暂无已结算记录</text>
  </view>
  <view wx:for="{{settledList}}" wx:key="otherUserId">
    <template is="settled-card" data="{{item, expandedMap}}" />
  </view>
</template>

<!-- 已结清卡片：显示净额 + 撤回按钮 + 可展开明细 -->
<template name="settled-card">
  <view class="glass-card person-card settled">
    <view class="person-head">
      <image class="person-avatar" src="{{item.avatar}}" mode="aspectFill" />
      <view class="person-info">
        <view class="person-name-row">
          <text class="person-name">{{item.nickname}}</text>
          <text class="settled-tag">已结清</text>
        </view>
        <text class="person-amount settled-amount">{{item.direction === 'they_owe' ? '已收' : '已付'}} ¥{{item.netAmountText}}</text>
      </view>
      <button class="settle-btn revert" data-id="{{item.otherUserId}}" data-name="{{item.nickname}}" catchtap="onRevert">撤回</button>
    </view>
    <view class="expand-toggle" data-id="{{item.otherUserId}}" bindtap="onToggleExpand">
      <text>{{expandedMap[item.otherUserId] ? '收起明细' : '展开明细（' + item.details.length + '笔）'}}</text>
      <van-icon name="{{expandedMap[item.otherUserId] ? 'arrow-up' : 'arrow-down'}}" size="12px" color="#8091a5" />
    </view>
    <view wx:if="{{expandedMap[item.otherUserId]}}" class="detail-list">
      <view wx:for="{{item.details}}" wx:for-item="d" wx:key="txId" class="detail-item">
        <view class="detail-icon"><image wx:if="{{d.categorySvg}}" class="detail-icon-svg" src="{{d.categorySvg}}" mode="aspectFit" /><van-icon wx:else name="{{d.categoryIcon}}" size="18px" color="#4097a9" /></view>
        <view class="detail-mid">
          <text class="detail-cat">{{d.categoryName}}</text>
          <text class="detail-note">{{d.note || d.dateText}}</text>
        </view>
        <view class="detail-right">
          <text class="detail-dir {{d.isTheyOwe ? 'in' : 'out'}}">{{d.isTheyOwe ? '+' : '-'}}¥{{d.amountText}}</text>
          <text class="detail-date">{{d.dateText}}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<view class="settle-detail-page">
  <!-- 顶部 tab：全部 / 待支付 / 待收款 / 已结算 -->
  <view class="tab-switch">
    <view class="tab-item {{tab === 'all' ? 'active' : ''}}" data-tab="all" bindtap="onSwitchTab">全部</view>
    <view class="tab-item {{tab === 'pay' ? 'active' : ''}}" data-tab="pay" bindtap="onSwitchTab">待支付</view>
    <view class="tab-item {{tab === 'receive' ? 'active' : ''}}" data-tab="receive" bindtap="onSwitchTab">待收款</view>
    <view class="tab-item {{tab === 'settled' ? 'active' : ''}}" data-tab="settled" bindtap="onSwitchTab">已结算</view>
  </view>

  <!-- 骨架屏 -->
  <block wx:if="{{loading}}">
    <view class="sk-user"></view>
    <view class="glass-card sk-card" wx:for="{{[1,2]}}" wx:key="*this">
      <view class="sk-row">
        <view class="sk-avatar"></view>
        <view class="sk-lines">
          <view class="sk-line sk-name"></view>
          <view class="sk-line sk-amt"></view>
        </view>
        <view class="sk-btn"></view>
      </view>
    </view>
  </block>

  <!-- 内容 -->
  <block wx:else>
    <!-- 全部 tab：按 sectionOrder 动态排序,三块都空时显示总空态 -->
    <block wx:if="{{tab === 'all'}}">
      <block wx:if="{{payables.length === 0 && receivables.length === 0 && settledList.length === 0}}">
        <!-- 三块都为空:显示总空态 -->
        <view class="empty-state global-empty">
          <van-icon name="notes-o" size="64px" color="#d9d9d9" />
          <text class="empty-text">暂无数据</text>
        </view>
      </block>
      <block wx:else>
        <!-- 有数据:只显示非空的 section,无数据的跳过 -->
        <block wx:for="{{sectionOrder}}" wx:key="*this" wx:for-item="sec">
          <template wx:if="{{sec === 'pay'}}" is="pay-section" data="{{payables, expandedMap, withHeader: true, showEmpty: false}}" />
          <template wx:else is="receive-section" data="{{receivables, expandedMap, withHeader: true, showEmpty: false}}" />
        </block>
        <!-- 已结算:有数据才显示 -->
        <template wx:if="{{settledList.length > 0}}" is="settled-section" data="{{settledList, expandedMap, withHeader: true, showEmpty: false}}" />
      </block>
    </block>

    <!-- 待支付 tab -->
    <template wx:elif="{{tab === 'pay'}}" is="pay-section" data="{{payables, expandedMap, withHeader: false, showEmpty: true}}" />

    <!-- 待收款 tab -->
    <template wx:elif="{{tab === 'receive'}}" is="receive-section" data="{{receivables, expandedMap, withHeader: false, showEmpty: true}}" />

    <!-- 已结算 tab -->
    <template wx:elif="{{tab === 'settled'}}" is="settled-section" data="{{settledList, expandedMap, withHeader: false, showEmpty: true}}" />
  </block>
</view>
