<view class="add-page">
  <!-- 骨架屏：初始数据加载中 -->
  <block wx:if="{{initLoading}}">
    <view class="sk-tabs">
      <view class="sk-tab"></view>
      <view class="sk-tab"></view>
    </view>
    <view class="sk-amount"></view>
    <view class="glass-card sk-section">
      <view class="sk-label"></view>
      <view class="sk-cat-grid">
        <view wx:for="{{[1,2,3,4,5,6,7,8]}}" wx:key="*this" class="sk-cat-item">
          <view class="sk-cat-icon"></view>
          <view class="sk-cat-name"></view>
        </view>
      </view>
    </view>
    <view class="glass-card sk-section">
      <view class="sk-label"></view>
      <view class="sk-chip-row">
        <view wx:for="{{[1,2,3]}}" wx:key="*this" class="sk-chip"></view>
      </view>
    </view>
    <view class="glass-card sk-section">
      <view class="sk-label"></view>
      <view class="sk-member-row">
        <view wx:for="{{[1,2,3,4]}}" wx:key="*this" class="sk-member-chip"></view>
      </view>
    </view>
    <view class="glass-card sk-row"></view>
    <view class="glass-card sk-row"></view>
    <view class="sk-save-btn"></view>
  </block>

  <block wx:else>
    <!-- 只读提示：非记录人查看他人账单 -->
    <view wx:if="{{readonly}}" class="readonly-tip">
      <van-icon name="eye-o" size="16px" color="#8091a5" />
      <text wx:if="{{readonlyReason === 'settled'}}">该账单已在结算中，需先删除结算轮次才能修改</text>
      <text wx:else>该账单由他人记录，仅记录人可修改</text>
    </view>

    <!-- 只读时用遮罩层拦截表单交互 -->
    <view class="form-wrap {{readonly ? 'readonly' : ''}}">
      <transaction-form
        wx:if="{{formReady}}"
        id="txForm"
        members="{{members}}"
        rates="{{rates}}"
        my-user-id="{{myUserId}}"
        book-id="{{bookId}}"
        initial="{{initial}}"
        autofocus="{{!isEdit}}"
      />
      <view wx:if="{{readonly}}" class="form-mask" catchtap="noop"></view>
    </view>

    <block wx:if="{{!readonly}}">
      <primary-button
        class="save-btn"
        text="保存"
        loading-text="保存中..."
        loading="{{saving}}"
        bind:tap="onSave"
      />
      <view wx:if="{{isEdit}}" class="delete-link" bindtap="onDelete">删除账单</view>
    </block>
    <view wx:if="{{isEdit}}" class="logs-link" bindtap="onOpenLogs">查看修改记录</view>
  </block>
</view>
