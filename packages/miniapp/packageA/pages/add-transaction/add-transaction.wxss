.add-page {
  padding: 24rpx 32rpx calc(60rpx + env(safe-area-inset-bottom));
}

.save-btn {
  margin-top: 24rpx;
}

.logs-link {
  text-align: center;
  font-size: 28rpx;
  color: var(--color-primary);
  margin-top: 32rpx;
}

.delete-link {
  text-align: center;
  font-size: 28rpx;
  color: var(--color-accent);
  margin-top: 28rpx;
}

/* ============ 骨架屏 ============ */
.sk-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.sk-tab {
  flex: 1;
  height: 80rpx;
  border-radius: 20rpx;
  background: #f2f3f5;
  animation: sk-blink 1.2s ease-in-out infinite;
}
.sk-amount {
  width: 60%;
  height: 96rpx;
  border-radius: 16rpx;
  background: #f2f3f5;
  margin: 0 auto 32rpx;
  animation: sk-blink 1.2s ease-in-out infinite;
}
.sk-section {
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}
.sk-label {
  width: 120rpx;
  height: 28rpx;
  border-radius: 14rpx;
  background: #f2f3f5;
  margin-bottom: 24rpx;
  animation: sk-blink 1.2s ease-in-out infinite;
}
.sk-cat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx 16rpx;
}
.sk-cat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.sk-cat-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: #f2f3f5;
  animation: sk-blink 1.2s ease-in-out infinite;
}
.sk-cat-name {
  width: 72rpx;
  height: 22rpx;
  border-radius: 11rpx;
  background: #f2f3f5;
  animation: sk-blink 1.2s ease-in-out infinite;
}
.sk-chip-row {
  display: flex;
  gap: 16rpx;
}
.sk-chip {
  width: 140rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #f2f3f5;
  animation: sk-blink 1.2s ease-in-out infinite;
}
.sk-member-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.sk-member-chip {
  width: 160rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #f2f3f5;
  animation: sk-blink 1.2s ease-in-out infinite;
}
.sk-row {
  height: 96rpx;
  margin-bottom: 24rpx;
  background: #f2f3f5;
  animation: sk-blink 1.2s ease-in-out infinite;
}
.sk-save-btn {
  height: 96rpx;
  border-radius: 48rpx;
  background: #f2f3f5;
  margin-top: 24rpx;
  animation: sk-blink 1.2s ease-in-out infinite;
}
@keyframes sk-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* 只读模式（非记录人查看） */
.readonly-tip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 24rpx;
  background: rgba(128, 145, 165, 0.1);
  border-radius: 16rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.form-wrap {
  position: relative;
}

.form-wrap.readonly {
  opacity: 0.7;
}

/* 透明遮罩：盖住表单拦截所有交互 */
.form-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
}
