.detail-page {
  padding: 0 32rpx calc(60rpx + env(safe-area-inset-bottom));
}

/* 头部卡片 */
.header-card {
  position: relative;
  height: 320rpx;
  border-radius: 32rpx;
  overflow: hidden;
  margin-top: 24rpx;
  /* 封面图未加载时的兜底底色，避免透出空白 */
  background: #fff;
}

.header-cover {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.header-overlay {
  position: absolute;
  inset: 0;
  /* 从左往右的渐变黑色蒙版，保证白色文字可读 */
  background: linear-gradient(90deg, rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0));
}

.header-content {
  position: absolute;
  inset: 0;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 头部右侧：分享 + 更多菜单 */
.header-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.header-share-btn {
  width: 56rpx;
  min-width: 56rpx;
  max-width: 56rpx;
  height: 56rpx;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  flex-shrink: 0;
  border: none;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  font-size: 0;
}
.header-share-btn::after {
  border: none;
}

.members-row {
  display: flex;
  align-items: center;
}

.member-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  border: 2rpx solid #fff;
  margin-right: -14rpx;
  background: #eee;
}

.member-invite {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
}

.more-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.amount-block {
  display: flex;
  flex-direction: column;
}

.amount-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.amount-value {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
}

.amount-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
}

/* 待支付 / 待收款 统计卡片 */
.settle-stat-card {
  display: flex;
  align-items: stretch;
  margin: 24rpx 0;
  padding: 20rpx 0;
  background: var(--bg-card);
  border-radius: 32rpx;
  box-shadow: 0 16rpx 64rpx rgba(47, 65, 89, 0.08);
}

.settle-stat-item {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}
.settle-stat-item:active {
  opacity: 0.6;
}

/* 向右箭头：提示可点击 */
.settle-stat-arrow {
  margin-left: 4rpx;
  flex-shrink: 0;
}

/* 图标底块 */
.settle-stat-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.settle-stat-icon.pay {
  background: rgba(250, 149, 131, 0.12);
}
.settle-stat-icon.receive {
  background: rgba(64, 151, 169, 0.12);
}

/* 右侧文字：标签 + 金额上下排 */
.settle-stat-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.settle-stat-divider {
  width: 2rpx;
  background: rgba(128, 145, 165, 0.15);
  margin: 4rpx 0;
}

.settle-stat-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.settle-stat-amount {
  display: flex;
  align-items: baseline;
}

.settle-stat-symbol {
  font-size: 26rpx;
  font-weight: 700;
  margin-right: 2rpx;
}

/* 金额：适中大小、纯色、等宽数字 */
.settle-stat-num {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.settle-stat-item.pay .settle-stat-symbol,
.settle-stat-item.pay .settle-stat-num {
  color: #fa9583;
}
.settle-stat-item.receive .settle-stat-symbol,
.settle-stat-item.receive .settle-stat-num {
  color: #4097a9;
}

/* 快捷操作 */
.quick-actions {
  display: flex;
  justify-content: space-around;
  margin: 24rpx 0;
  padding: 28rpx 0;
  background: var(--bg-card);
  border-radius: 32rpx;
  box-shadow: 0 16rpx 64rpx rgba(47, 65, 89, 0.08);
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--text-primary);
  background: transparent;
  line-height: 1.4;
  margin: 0;
  padding: 0;
}

.quick-item text {
  margin-top: 10rpx;
}

/* 快捷操作图标包裹层（用于放角标） */
.quick-item-icon-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 快捷操作角标：红色圆点，数字居中 */
.quick-item-badge {
  position: absolute;
  top: -6rpx;
  right: -12rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #fa9583;
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  text-align: center;
}

/* button 版快捷项：清掉小程序 button 默认样式，与 view 项对齐 */
.share-btn {
  border: none;
  border-radius: 0;
}

.share-btn::after {
  border: none;
}

/* 账单筛选 tab */
.tx-filter {
  display: flex;
  background: rgba(64, 151, 169, 0.08);
  border-radius: 40rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}

.tx-filter-tab {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 34rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.tx-filter-tab.active {
  background: var(--color-primary);
  color: #fff;
  font-weight: 600;
}

/* tab 角标：显示笔数 */
.tx-filter-badge {
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: rgba(64, 151, 169, 0.16);
  color: var(--color-primary);
  font-size: 20rpx;
  font-weight: 600;
  text-align: center;
}

/* 选中态角标：反白 */
.tx-filter-tab.active .tx-filter-badge {
  background: rgba(255, 255, 255, 0.28);
  color: #fff;
}

/* 分类 / 支付方式 下拉筛选按钮（并排，在 tx-filter 下方）*/
.dropdown-filters {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.dropdown-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 32rpx;
  background: rgba(128, 145, 165, 0.08);
  font-size: 26rpx;
  color: var(--text-secondary);
}

.dropdown-btn.active {
  background: rgba(64, 151, 169, 0.12);
  color: var(--color-primary);
  font-weight: 500;
}

/* 流水 */
.tx-date {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin: 24rpx 8rpx 12rpx;
}

.tx-list {
  padding: 8rpx 24rpx;
}

.tx-item {
  position: relative;
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid rgba(128, 145, 165, 0.12);
}

.tx-item:last-child {
  border-bottom: none;
}

/* 付款人头像 */
.tx-payer {
  margin-right: 16rpx;
  flex-shrink: 0;
}
.tx-payer-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #eef1f4;
  display: block;
}
.tx-payer-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #fff;
  background: #4097a9;
}

.tx-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: rgba(64, 151, 169, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
/* 自定义 SVG 分类图标（饮品），尺寸对齐 van-icon 22px */
.tx-icon-svg {
  width: 44rpx;
  height: 44rpx;
}

.tx-item.private .tx-icon {
  background: rgba(47, 65, 89, 0.1);
}

.tx-mid {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.tx-title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  overflow: hidden;
}

.tx-cat {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  flex-shrink: 0;
}

/* 已结算小标签 */
.tx-settled-tag {
  font-size: 18rpx;
  color: #52c41a;
  background: rgba(82, 196, 26, 0.12);
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
}

/* 结算中标签：橙色，区别于绿色「已结算」 */
.tx-settling-tag {
  font-size: 18rpx;
  color: #fa9583;
  background: rgba(250, 149, 131, 0.14);
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
}

/* 账单卡片：应付/应收左侧竖线（绝对定位，不占布局空间） */
.tx-item.my-payment {
  position: relative;
}

.tx-item.has-receive::before,
.tx-item.has-pay::before {
  content: '';
  position: absolute;
  left: -15rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 48rpx;
  border-radius: 4rpx;
}
/* 应收：蓝绿色竖线 */
.tx-item.has-receive::before {
  background: #4097a9;
}
/* 应付：橙红色竖线 */
.tx-item.has-pay::before {
  background: #fa9c8b;
}

/* 应收：图标底色统一为蓝绿 */
.tx-item.has-receive .tx-icon {
  background: rgba(64, 151, 169, 0.12);
}
/* 应付：图标底色统一为橙红 */
.tx-item.has-pay .tx-icon {
  background: rgba(250, 156, 139, 0.12);
}

.tx-item.my-payment .tx-icon {
  background: rgba(64, 151, 169, 0.18);
}

/* 已结算堆叠样式已抽取到 components/card-stack；顶部/列表卡片内容仍复用下方 tx-* 样式 */

.tx-note {
  font-size: 24rpx;
  color: var(--text-secondary);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tx-myshare {
  font-size: 22rpx;
  color: #fa9c8b;
  margin-top: 6rpx;
}

/* 我应收：主色蓝绿 */
.tx-myshare.receive {
  color: #4097a9;
  font-weight: 600;
}

.tx-notinvolved {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  opacity: 0.7;
}

/* 右侧：金额 + 我应收/应付竖排，右对齐 */
.tx-right {
  flex-shrink: 0;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.tx-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-accent);
}

.my-payment .tx-amount{
color: #4097a9;
}


.empty-tx {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-tx-img {
  width: 300rpx;
  height: 240rpx;
}

.empty-tx-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 24rpx;
}

/* ============ 骨架屏 ============ */
.skeleton-header-card {
  height: 320rpx;
  border-radius: 32rpx;
  background: linear-gradient(180deg, #e6ebef 0%, #d5dde4 100%);
  margin-top: 24rpx;
  padding: 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  animation: skel-blink 1.2s ease-in-out infinite;
}

.skeleton-header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.skeleton-avatars {
  display: flex;
}

.skeleton-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 2rpx solid #fff;
  margin-right: -14rpx;
}

.skeleton-menu-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.35);
}

.skeleton-header-bottom {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.skeleton-line-22 {
  height: 22rpx;
  border-radius: 11rpx;
  background: rgba(255, 255, 255, 0.6);
}
.skeleton-line-24 {
  height: 24rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.6);
}
.skeleton-line-28 {
  height: 28rpx;
  border-radius: 14rpx;
  background: #f2f3f5;
}
.skeleton-line-30 {
  height: 30rpx;
  border-radius: 14rpx;
  background: #f2f3f5;
}
.skeleton-line-56 {
  height: 56rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.7);
}
.w60 {
  width: 60rpx;
}
.w120 {
  width: 120rpx;
}
.w160 {
  width: 160rpx;
}
.w220 {
  width: 220rpx;
}
.w280 {
  width: 280rpx;
}
.w360 {
  width: 360rpx;
}

.skeleton-record-btn {
  width: 100%;
  height: 108rpx;
  margin: 28rpx 0 16rpx;
  border-radius: 48rpx;
  background: #f2f3f5;
  animation: skel-blink 1.2s ease-in-out infinite;
}

.skeleton-quick-actions {
  display: flex;
  justify-content: space-around;
  padding: 28rpx 0;
  border-radius: 32rpx;
  background: var(--bg-card);
  box-shadow: 0 16rpx 64rpx rgba(47, 65, 89, 0.08);
  margin-bottom: 24rpx;
}

.skeleton-quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.skeleton-quick-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #f2f3f5;
  animation: skel-blink 1.2s ease-in-out infinite;
}

.skeleton-tx-date {
  width: 200rpx;
  height: 24rpx;
  border-radius: 12rpx;
  background: #f2f3f5;
  margin: 24rpx 8rpx 12rpx;
  animation: skel-blink 1.2s ease-in-out infinite;
}

.skeleton-tx-list {
  padding: 8rpx 24rpx;
}

.skeleton-tx-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid rgba(128, 145, 165, 0.12);
}

.skeleton-tx-item:last-child {
  border-bottom: none;
}

.skeleton-tx-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #f2f3f5;
  margin-right: 20rpx;
  animation: skel-blink 1.2s ease-in-out infinite;
}

.skeleton-tx-mid {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

@keyframes skel-blink {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.55;
  }
}

/* 主 CTA：记一笔（页内独立按钮） */
/* 手动录入 + 票据自动识别 双按钮 */
.record-actions {
  display: flex;
  gap: 20rpx;
  margin: 28rpx 0 16rpx;
}
.record-btn {
  flex: 1;
  height: 100rpx;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}
.record-btn::after {
  border: none;
}
.record-btn.manual {
  background: var(--color-accent) !important;
  color: #fff !important;
  box-shadow: 0 12rpx 32rpx rgba(250, 149, 131, 0.35);
}
.record-btn.ocr {
  background: rgba(64, 151, 169, 0.1) !important;
  color: var(--color-primary) !important;
  border: 2rpx solid var(--color-primary) !important;
}

/* 进行中轮次弹窗 */
.round-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  width: 100vw;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1001;
  display: flex;
  align-items: flex-end;
}
.round-panel {
  width: 100vw;
  box-sizing: border-box;
  background: #f5f6fa;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}
.round-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.round-panel-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.round-panel-sub {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
  display: block;
}
.round-list {
  margin: 24rpx 0;
}
.round-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.round-item-main {
  flex: 1;
  min-width: 0;
}
.round-item-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.round-item-type {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.round-item-badge {
  font-size: 20rpx;
  color: #fa9583;
  background: rgba(250, 149, 131, 0.12);
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
}
.round-item-meta {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
  display: block;
}
.round-item-del {
  padding: 12rpx 12rpx 12rpx 24rpx;
  flex-shrink: 0;
}
.round-new-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: var(--color-primary) !important;
  color: #fff !important;
  font-size: 30rpx;
  font-weight: 600;
  border: none !important;
}
.round-new-btn::after { border: none; }

/* ============ 筛选抽屉 ============ */
.filter-mask {
  position: fixed;
  inset: 0;
  z-index: 999;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
}

.filter-panel {
  width: 100%;
  max-height: 75vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.filter-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.filter-panel-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.filter-panel-reset {
  font-size: 26rpx;
  color: var(--color-primary);
  padding: 8rpx 16rpx;
}

.filter-options {
  flex: 1;
  overflow-y: auto;
  margin-bottom: 24rpx;
}

.filter-option {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  border-radius: 24rpx;
  background: rgba(128, 145, 165, 0.06);
}

.filter-option.active {
  background: var(--color-primary);
}

.filter-option-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: rgba(64, 151, 169, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.filter-option.active .filter-option-icon {
  background: rgba(255, 255, 255, 0.2);
}
/* 自定义 SVG 分类图标（饮品），尺寸对齐 van-icon 20px */
