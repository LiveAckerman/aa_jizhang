<view class="share-summary-page">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-state">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 已过期 -->
  <view wx:elif="{{expired}}" class="expired-state">
    <van-icon name="clock-o" size="64px" color="#8091a5" />
    <text class="expired-title">分享链接已过期</text>
    <text class="expired-text">该分享链接已失效，请联系分享人重新生成</text>
    <button class="btn-back" bindtap="onBackHome">返回首页</button>
  </view>

  <!-- 正常内容 -->
  <view wx:else class="content">
    <!-- 头部：账本信息 -->
    <view class="book-card">
      <view class="book-info">
        <image wx:if="{{book.coverUrl}}" class="book-cover" src="{{book.coverUrl}}" mode="aspectFill" />
        <view wx:else class="book-cover-placeholder">
          <van-icon name="photo-o" size="28px" color="#8091a5" />
        </view>
        <view class="book-meta">
          <text class="book-name">{{book.name}}</text>
          <text class="book-member-count">{{book.memberCount}} 人参与</text>
        </view>
      </view>
      <view class="member-avatars">
        <image
          wx:for="{{book.members}}"
          wx:key="index"
          class="member-avatar"
          src="{{item.avatar}}"
          mode="aspectFill"
        />
      </view>
    </view>

    <!-- 总览卡片 -->
    <view class="summary-card">
      <view class="summary-row">
        <text class="summary-label">总金额</text>
        <text class="summary-value primary">¥{{summary.totalAmountText}}</text>
      </view>
      <view class="summary-row">
        <text class="summary-label">账单笔数</text>
        <text class="summary-value">{{summary.txCount}} 笔</text>
      </view>
      <view class="summary-divider"></view>
      <!-- 包含未结算勾选 -->
      <view class="summary-row settle-toggle">
        <text class="summary-label">包含未结算账单</text>
        <switch checked="{{includeUnsettled}}" bindchange="onToggleUnsettled" color="#4097a9" />
      </view>
    </view>

    <!-- 维度切换 tab -->
    <view class="tab-switch">
      <view
        class="tab-item {{groupBy === 'person' ? 'active' : ''}}"
        bindtap="onSwitchGroupBy"
        data-key="person"
      >按人员</view>
      <view
        class="tab-item {{groupBy === 'category' ? 'active' : ''}}"
        bindtap="onSwitchGroupBy"
        data-key="category"
      >按分类</view>
      <view
        class="tab-item {{groupBy === 'paymentMethod' ? 'active' : ''}}"
        bindtap="onSwitchGroupBy"
        data-key="paymentMethod"
      >按支付方式</view>
    </view>

    <!-- 分组明细列表 -->
    <view class="groups-section">
      <view class="group-list">
        <view wx:for="{{groups}}" wx:key="index" class="group-card">
          <!-- 可点击的头部区域 -->
          <view class="group-header" bindtap="toggleGroup" data-key="{{item.key}}">
            <!-- 左侧：图标或头像 -->
            <view class="group-icon-area">
              <image wx:if="{{groupBy === 'person' && item.avatar}}" class="group-avatar" src="{{item.avatar}}" mode="aspectFill" />
              <view wx:elif="{{groupBy === 'person'}}" class="group-avatar-placeholder">
                <van-icon name="manager-o" size="24px" color="#8091a5" />
              </view>
              <view wx:elif="{{groupBy === 'category'}}" class="group-icon-box">
                <image wx:if="{{item.svgIcon}}" class="category-svg" src="{{item.svgIcon}}" mode="aspectFit" />
                <van-icon wx:else name="{{item.icon || 'more-o'}}" size="24px" color="#4097a9" />
              </view>
              <view wx:else class="group-icon-box">
                <van-icon name="{{item.icon || 'card'}}" size="24px" color="#4097a9" />
              </view>
            </view>

            <!-- 中间：标签和副标签 -->
            <view class="group-info">
              <text class="group-label">{{item.label}}</text>
              <text class="group-sublabel">{{item.sublabel}}</text>
            </view>

            <!-- 右侧：金额 + 折叠箭头 -->
            <view class="group-amount-area">
              <text class="group-amount">¥{{item.totalAmountText}}</text>
              <van-icon name="{{expandedMap[item.key] ? 'arrow-up' : 'arrow-down'}}" size="14px" color="#8091a5" />
            </view>
          </view>

          <!-- 账单明细列表（展开时显示） -->
          <view class="group-detail" wx:if="{{expandedMap[item.key]}}">
            <view class="tx-item" wx:for="{{item.transactions}}" wx:key="id" wx:for-item="tx">
              <view class="tx-row">
                <text class="tx-note">{{tx.note || '无备注'}}</text>
                <text class="tx-amount">¥{{tx.amountText}}</text>
              </view>
              <view class="tx-meta">
                <text class="tx-tag">{{tx.categoryName}}</text>
                <text class="tx-dot"> · </text>
                <text class="tx-date">{{tx.spentAt}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部操作区 -->
    <view class="footer-actions">
      <button class="btn-share" open-type="share">
        <van-icon name="share-o" size="18px" />
        <text>分享</text>
      </button>
      <button class="btn-save" bindtap="onSaveImage" disabled="{{saving}}">
        <van-icon name="photo-o" size="18px" />
        <text>{{saving ? '生成中...' : '保存图片'}}</text>
      </button>
    </view>

    <!-- 离屏 Canvas（用于生成图片，用户不可见） -->
    <canvas type="2d" id="summaryCanvas" style="position: fixed; left: -9999px; top: -9999px; width: 375px; height: 1000px;"></canvas>
  </view>
</view>
