<view class="share-summary-page">
  <!-- 整页骨架屏：首次加载 -->
  <view wx:if="{{loading && !book}}" class="skeleton-container">
    <!-- 骨架屏：账本信息卡片 -->
    <view class="skeleton-header">
      <view class="skeleton-avatar-large"></view>
      <view class="skeleton-line w200 h40"></view>
      <view class="skeleton-line w120 h24"></view>
    </view>

    <!-- 骨架屏：总览卡片 -->
    <view class="skeleton-summary">
      <view class="skeleton-row">
        <view class="skeleton-line w80 h28"></view>
        <view class="skeleton-line w120 h40"></view>
      </view>
      <view class="skeleton-row">
        <view class="skeleton-line w80 h28"></view>
        <view class="skeleton-line w100 h28"></view>
      </view>
    </view>

    <!-- 骨架屏：分组列表 -->
    <view class="skeleton-list">
      <view class="skeleton-list-item" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="skeleton-avatar"></view>
        <view class="skeleton-mid">
          <view class="skeleton-line w120 h28"></view>
          <view class="skeleton-line w80 h24"></view>
        </view>
        <view class="skeleton-line w100 h32"></view>
      </view>
    </view>
  </view>

  <!-- 已过期 -->
  <view wx:elif="{{expired}}" class="expired-state">
    <van-icon name="clock-o" size="64px" color="#8091a5" />
    <text class="expired-title">分享链接已过期</text>
    <text class="expired-text">该分享链接已失效，请联系分享人重新生成</text>
    <button class="btn-back" bindtap="onBackHome">返回首页</button>
  </view>

  <!-- 正常内容 -->
  <view wx:else class="content">
    <!-- 账本信息卡片 -->
    <view class="book-card">
      <view class="book-info">
        <image wx:if="{{book.coverUrl}}" class="book-cover" src="{{book.coverUrl}}" mode="aspectFill" />
        <view wx:else class="book-cover-placeholder">
          <van-icon name="photo-o" size="28px" color="#8091a5" />
        </view>
        <view class="book-meta">
          <text class="book-name">{{book.name}}</text>
          <text class="book-member-count">{{book.memberCount}} 人参与</text>
        </view>
      </view>
      <view class="member-avatars">
        <image wx:for="{{book.members}}" wx:key="index" class="member-avatar" src="{{item.avatar}}" mode="aspectFill" />
      </view>
    </view>

    <!-- 总览卡片 -->
    <view class="summary-card">
      <view class="summary-row">
        <text class="summary-label">总金额</text>
        <text class="summary-value primary">¥{{summary.totalAmountText}}</text>
      </view>
      <view class="summary-row">
        <text class="summary-label">账单笔数</text>
        <text class="summary-value">{{summary.txCount}} 笔</text>
      </view>
      <view class="summary-row settle-toggle">
        <text class="summary-label">包含未结算账单</text>
        <switch checked="{{includeUnsettled}}" bindchange="onToggleUnsettled" color="#4097a9" />
      </view>
    </view>

    <!-- 维度切换 tab -->
    <view class="tab-switch">
      <view class="tab-item {{groupBy === 'person' ? 'active' : ''}}" bindtap="onSwitchGroupBy" data-key="person">按人员</view>
      <view class="tab-item {{groupBy === 'category' ? 'active' : ''}}" bindtap="onSwitchGroupBy" data-key="category">按分类</view>
      <view class="tab-item {{groupBy === 'paymentMethod' ? 'active' : ''}}" bindtap="onSwitchGroupBy" data-key="paymentMethod">按支付方式</view>
    </view>

    <!-- 分组明细列表：二次加载时只 loading 这个区域 -->
    <view class="groups-section">
      <!-- 列表骨架屏 -->
      <block wx:if="{{groupsLoading}}">
        <view class="glass-card tx-list skeleton-group" wx:for="{{[1,2,3]}}" wx:key="*this">
          <view class="skeleton-group-row">
            <view class="skeleton-avatar"></view>
            <view class="skeleton-lines">
              <view class="skeleton-line w60"></view>
              <view class="skeleton-line w40"></view>
            </view>
            <view class="skeleton-line w30"></view>
          </view>
        </view>
      </block>

      <!-- 实际列表 -->
      <block wx:else>
        <view wx:for="{{groups}}" wx:key="index" class="group-block">
          <!-- 分组头部（可折叠） -->
          <view class="group-header" bindtap="toggleGroup" data-key="{{item.key}}">
            <view class="group-icon-area">
              <!-- 人员：头像 -->
              <image wx:if="{{groupBy === 'person' && item.avatar}}" class="group-avatar" src="{{item.avatar}}" mode="aspectFill" />
              <view wx:elif="{{groupBy === 'person'}}" class="group-avatar-placeholder">
                <van-icon name="manager-o" size="22px" color="#8091a5" />
              </view>
              <!-- 分类 -->
              <view wx:elif="{{groupBy === 'category'}}" class="group-icon-box">
                <image wx:if="{{item.svgIcon}}" class="group-icon-svg" src="{{item.svgIcon}}" mode="aspectFit" />
                <van-icon wx:else name="{{item.icon || 'more-o'}}" size="22px" color="#4097a9" />
              </view>
              <!-- 支付方式 -->
              <view wx:else class="group-icon-box">
                <van-icon name="{{item.icon || 'card'}}" size="22px" color="#4097a9" />
              </view>
            </view>
            <view class="group-info">
              <text class="group-label">{{item.label}}</text>
              <text class="group-sublabel">{{item.sublabel}}</text>
            </view>
            <view class="group-right">
              <text class="group-amount">¥{{item.totalAmountText}}</text>
              <van-icon name="{{expandedMap[item.key] ? 'arrow-up' : 'arrow-down'}}" size="14px" color="#8091a5" />
            </view>
          </view>

          <!-- 账单明细（展开时，样式对齐 book-detail） -->
          <view wx:if="{{expandedMap[item.key]}}" class="glass-card tx-list">
            <view
              wx:for="{{item.transactions}}"
              wx:key="id"
              wx:for-item="tx"
              class="tx-item"
            >
              <!-- 付款人头像区域（按分类/支付方式时显示） -->
              <view wx:if="{{groupBy !== 'person'}}" class="tx-payer">
                <image wx:if="{{tx.payerAvatar}}" class="tx-payer-avatar" src="{{tx.payerAvatar}}" mode="aspectFill" />
                <view wx:else class="tx-payer-avatar tx-payer-avatar-fallback">{{tx.payerNickname[0]}}</view>
              </view>
              <!-- 分类图标区域 -->
              <view class="tx-icon">
                <image wx:if="{{tx.categorySvg}}" class="tx-icon-svg" src="{{tx.categorySvg}}" mode="aspectFit" />
                <van-icon wx:else name="{{tx.categoryIcon || 'shopping-cart-o'}}" size="22px" color="#4097a9" />
              </view>
              <view class="tx-mid">
                <view class="tx-title-row">
                  <text class="tx-cat">{{tx.categoryName}}</text>
                </view>
                <text class="tx-note">{{tx.note || tx.payerNickname + ' 付款'}}</text>
              </view>
              <view class="tx-right">
                <text class="tx-amount">¥{{tx.amountText}}</text>
                <text class="tx-date-tag">{{tx.spentAt}}</text>
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>

    <!-- 底部操作区 -->
    <view class="footer-actions">
      <primary-button
        class="footer-btn"
        type="outline"
        text="分享"
        open-type="share"
      />
      <primary-button
        class="footer-btn"
        type="primary"
        text="保存图片"
        loading-text="生成中..."
        loading="{{saving}}"
        bind:tap="onSaveImage"
      />
    </view>

    <!-- 离屏 Canvas（用于生成图片，用户不可见；尺寸动态绑定，不能用 wx:if/hidden 隐藏） -->
    <canvas type="2d" id="summaryCanvas" style="position: fixed; left: -9999px; top: -9999px; width: {{canvasW}}px; height: {{canvasH}}px;"></canvas>
  </view>
</view>
