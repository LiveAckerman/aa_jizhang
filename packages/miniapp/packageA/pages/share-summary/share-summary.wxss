/* ===== share-summary 页面：风格与其他二级页面保持一致 ===== */

.share-summary-page {
  min-height: 100vh;
  padding: 24rpx 32rpx calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== 加载中 / 过期状态 ===== */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  gap: 24rpx;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid var(--color-primary, #4097a9);
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.loading-text {
  font-size: 28rpx;
  color: var(--text-secondary, #8091a5);
}

.expired-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  gap: 24rpx;
  padding: 0 48rpx;
}
.expired-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary, #2f4159);
}
.expired-text {
  font-size: 26rpx;
  color: var(--text-secondary, #8091a5);
  text-align: center;
  line-height: 1.6;
}
.btn-back {
  margin-top: 16rpx;
  background: var(--color-primary, #4097a9);
  color: #fff;
  border-radius: 48rpx;
  font-size: 30rpx;
  padding: 0 64rpx;
  height: 88rpx;
  line-height: 88rpx;
}

/* ===== 账本信息卡片 ===== */
.book-card {
  background: var(--bg-card, rgba(255,255,255,0.85));
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(64, 151, 169, 0.1);
}
.book-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 20rpx;
}
.book-cover {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}
.book-cover-placeholder {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: rgba(64,151,169,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.book-meta { flex: 1; }
.book-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary, #2f4159);
  margin-bottom: 6rpx;
}
.book-member-count {
  font-size: 24rpx;
  color: var(--text-secondary, #8091a5);
}
.member-avatars {
  display: flex;
  gap: 8rpx;
}
.member-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 2rpx solid #fff;
}

/* ===== 总览卡片 ===== */
.summary-card {
  background: var(--bg-card, rgba(255,255,255,0.85));
  border-radius: 24rpx;
  padding: 8rpx 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(64, 151, 169, 0.1);
}
.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}
.summary-row:last-child { border-bottom: none; }
.summary-label {
  font-size: 28rpx;
  color: var(--text-secondary, #8091a5);
}
.summary-value {
  font-size: 28rpx;
  color: var(--text-primary, #2f4159);
  font-weight: 500;
}
.summary-value.primary {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary, #4097a9);
}
.summary-divider {
  height: 1rpx;
  background: rgba(0,0,0,0.04);
  margin: 0 -32rpx;
}
.settle-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* ===== 维度切换 tab ===== */
.tab-switch {
  display: flex;
  background: rgba(64, 151, 169, 0.08);
  border-radius: 48rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}
.tab-item {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: var(--text-secondary, #8091a5);
}
.tab-item.active {
  background: var(--color-primary, #4097a9);
  color: #fff;
  font-weight: 600;
}

/* ===== 分组列表 ===== */
.group-list { display: flex; flex-direction: column; gap: 16rpx; }

.group-card {
  background: var(--bg-card, rgba(255,255,255,0.85));
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid rgba(64, 151, 169, 0.08);
}
.group-header {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  gap: 24rpx;
}
.group-icon-area { flex-shrink: 0; }
.group-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}
.group-avatar-placeholder {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(64,151,169,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}
.group-icon-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: rgba(64,151,169,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}
.category-svg { width: 40rpx; height: 40rpx; }

.group-info {
  flex: 1;
  min-width: 0;
}
.group-label {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary, #2f4159);
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.group-sublabel {
  font-size: 24rpx;
  color: var(--text-secondary, #8091a5);
}

.group-amount-area {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}
.group-amount {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-primary, #4097a9);
}

/* ===== 账单明细（展开） ===== */
.group-detail {
  border-top: 1rpx solid rgba(0,0,0,0.05);
  padding: 0 32rpx;
}
.tx-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}
.tx-item:last-child { border-bottom: none; }
.tx-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.tx-note {
  font-size: 28rpx;
  color: var(--text-primary, #2f4159);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tx-amount {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary, #2f4159);
  flex-shrink: 0;
  margin-left: 16rpx;
}
.tx-meta {
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.tx-tag {
  font-size: 22rpx;
  color: var(--text-secondary, #8091a5);
  background: rgba(64,151,169,0.08);
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
}
.tx-dot { font-size: 22rpx; color: var(--text-secondary, #8091a5); }
.tx-date { font-size: 22rpx; color: var(--text-secondary, #8091a5); }

/* ===== 底部操作区 ===== */
.footer-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(12px);
  display: flex;
  gap: 20rpx;
  border-top: 1rpx solid rgba(0,0,0,0.06);
}
.btn-share,
.btn-save {
  flex: 1;
  height: 88rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}
.btn-share {
  background: rgba(64,151,169,0.12);
  color: var(--color-primary, #4097a9);
}
.btn-save {
  background: var(--color-primary, #4097a9);
  color: #fff;
}
.btn-share::after,
.btn-save::after { border: none; }
