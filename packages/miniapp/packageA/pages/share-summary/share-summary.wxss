/* 导入公共账单卡片样式 */
@import '/styles/tx-card.wxss';

/* ===== share-summary 页面专属样式 ===== */
.share-summary-page {
  min-height: 100vh;
  padding: 24rpx 32rpx calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== 加载中 ===== */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  gap: 24rpx;
}
.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid var(--color-primary, #4097a9);
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 28rpx; color: var(--text-secondary, #8091a5); }

/* ===== 已过期 ===== */
.expired-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  gap: 24rpx;
  padding: 0 48rpx;
}
.expired-title { font-size: 34rpx; font-weight: 600; color: var(--text-primary, #2f4159); }
.expired-text { font-size: 26rpx; color: var(--text-secondary, #8091a5); text-align: center; line-height: 1.6; }
.btn-back {
  margin-top: 16rpx;
  background: var(--color-primary, #4097a9);
  color: #fff;
  border-radius: 48rpx;
  font-size: 30rpx;
  padding: 0 64rpx;
  line-height: 88rpx;
}

/* ===== 总览卡片 ===== */
.summary-card {
  background: var(--bg-card, rgba(255,255,255,0.85));
  border-radius: 24rpx;
  padding: 8rpx 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(64, 151, 169, 0.1);
}
.summary-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}
.summary-row:last-child { border-bottom: none; }
.summary-label { font-size: 28rpx; color: var(--text-secondary, #8091a5); }
.summary-value { font-size: 28rpx; color: var(--text-primary, #2f4159); font-weight: 500; }
.summary-value.primary { font-size: 36rpx; font-weight: 700; color: var(--color-primary, #4097a9); }
.settle-toggle { display: flex; justify-content: space-between; align-items: center; }

/* ===== 维度切换 tab ===== */
.tab-switch {
  display: flex;
  background: rgba(64, 151, 169, 0.08);
  border-radius: 48rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}
.tab-item {
  flex: 1; height: 72rpx; line-height: 72rpx;
  text-align: center; border-radius: 40rpx;
  font-size: 28rpx; color: var(--text-secondary, #8091a5);
}
.tab-item.active { background: var(--color-primary, #4097a9); color: #fff; font-weight: 600; }

/* ===== 分组头部 ===== */
.group-block { margin-bottom: 16rpx; }

.group-header {
  display: flex; align-items: center;
  padding: 24rpx 32rpx;
  background: var(--bg-card, rgba(255,255,255,0.85));
  border-radius: 20rpx;
  margin-bottom: 4rpx;
  border: 1rpx solid rgba(64, 151, 169, 0.08);
  gap: 24rpx;
}
.group-icon-area { flex-shrink: 0; }
.group-avatar { width: 72rpx; height: 72rpx; border-radius: 50%; }
.group-avatar-placeholder {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: rgba(64,151,169,0.08);
  display: flex; align-items: center; justify-content: center;
}
.group-icon-box {
  width: 72rpx; height: 72rpx; border-radius: 16rpx;
  background: rgba(64,151,169,0.08);
  display: flex; align-items: center; justify-content: center;
}
.group-icon-svg { width: 40rpx; height: 40rpx; }

.group-info { flex: 1; min-width: 0; }
.group-label {
  display: block; font-size: 30rpx; font-weight: 500;
  color: var(--text-primary, #2f4159);
  margin-bottom: 6rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.group-sublabel { font-size: 24rpx; color: var(--text-secondary, #8091a5); }

.group-right { display: flex; align-items: center; gap: 8rpx; flex-shrink: 0; }
.group-amount { font-size: 30rpx; font-weight: 600; color: var(--color-primary, #4097a9); }

/* 展开后的账单列表：圆角接在分组头部下方 */
.group-block .glass-card.tx-list {
  border-radius: 0 0 20rpx 20rpx;
  border-top: none;
}

/* ===== 底部操作区 ===== */
.footer-actions {
  position: fixed; bottom: 0; left: 0; right: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(12px);
  display: flex; gap: 20rpx;
  border-top: 1rpx solid rgba(0,0,0,0.06);
}
/* 两个 primary-button 等宽并排 */
.footer-btn {
  flex: 1;
}

/* ===== 账单列表项样式 ===== */
.tx-list { padding: 0; }
.tx-item {
  display: flex; align-items: center; gap: 24rpx;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}
.tx-item:last-child { border-bottom: none; }

/* 付款人头像区域 */
.tx-payer {
  flex-shrink: 0;
  width: 72rpx; height: 72rpx;
  position: relative;
}
.tx-payer-avatar {
  width: 72rpx; height: 72rpx;
  border-radius: 50%;
  display: block;
}
.tx-payer-avatar-fallback {
  background: rgba(64,151,169,0.12);
  color: var(--color-primary, #4097a9);
  font-size: 28rpx; font-weight: 500;
  display: flex; align-items: center; justify-content: center;
}

/* 分类图标区域 */
.tx-icon {
  flex-shrink: 0;
  width: 72rpx; height: 72rpx;
  border-radius: 16rpx;
  background: rgba(64,151,169,0.08);
  display: flex; align-items: center; justify-content: center;
}
.tx-icon-svg { width: 40rpx; height: 40rpx; }

/* 中间文本区域 */
.tx-mid { flex: 1; min-width: 0; }
.tx-title-row {
  display: flex; align-items: center; gap: 12rpx;
  margin-bottom: 6rpx;
}
.tx-cat {
  font-size: 30rpx; font-weight: 500;
  color: var(--text-primary, #2f4159);
}
.tx-note {
  font-size: 24rpx;
  color: var(--text-secondary, #8091a5);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* 右侧金额区域 */
.tx-right {
  flex-shrink: 0;
  display: flex; flex-direction: column; align-items: flex-end;
  gap: 4rpx;
}
.tx-amount {
  font-size: 32rpx; font-weight: 600;
  color: var(--text-primary, #2f4159);
}
.tx-date-tag {
  font-size: 22rpx;
  color: var(--text-tertiary, #a0aab5);
}

/* ===== 骨架屏 ===== */
.skeleton-container {
  padding: 24rpx 0;
}

.skeleton-header {
  display: flex; flex-direction: column; align-items: center; gap: 16rpx;
  padding: 48rpx 32rpx; margin-bottom: 24rpx;
  background: var(--bg-card, #fff); border-radius: 32rpx;
}

.skeleton-avatar-large {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: linear-gradient(90deg, #f0f0f0 25%, #f8f8f8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
}

.skeleton-line {
  height: 28rpx; border-radius: 8rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #f8f8f8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
}

.skeleton-line.w60 { width: 60rpx; }
.skeleton-line.w80 { width: 80rpx; }
.skeleton-line.w100 { width: 100rpx; }
.skeleton-line.w120 { width: 120rpx; }
.skeleton-line.w200 { width: 200rpx; }
.skeleton-line.h24 { height: 24rpx; }
.skeleton-line.h28 { height: 28rpx; }
.skeleton-line.h32 { height: 32rpx; }
.skeleton-line.h40 { height: 40rpx; }

.skeleton-summary {
  padding: 32rpx; margin-bottom: 24rpx;
  background: var(--bg-card, #fff); border-radius: 32rpx;
  display: flex; flex-direction: column; gap: 24rpx;
}

.skeleton-row {
  display: flex; justify-content: space-between; align-items: center;
}

.skeleton-list {
  display: flex; flex-direction: column; gap: 16rpx;
}

.skeleton-list-item {
  padding: 28rpx; background: var(--bg-card, #fff); border-radius: 24rpx;
  display: flex; align-items: center; gap: 20rpx;
}

.skeleton-avatar {
  width: 72rpx; height: 72rpx; border-radius: 50%; flex-shrink: 0;
  background: linear-gradient(90deg, #f0f0f0 25%, #f8f8f8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
}

.skeleton-mid {
  flex: 1; display: flex; flex-direction: column; gap: 12rpx;
}

.skeleton-group {
  padding: 28rpx; margin-bottom: 16rpx;
}

.skeleton-group-row {
  display: flex; align-items: center; gap: 20rpx;
}

.skeleton-lines {
  flex: 1; display: flex; flex-direction: column; gap: 12rpx;
}

@keyframes skeleton-loading {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
