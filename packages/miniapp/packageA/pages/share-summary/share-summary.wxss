page {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  min-height: 100vh;
}

.share-summary-page {
  min-height: 100vh;
  padding: 32rpx 24rpx 120rpx;
}

/* ===== 加载中 / 过期状态 ===== */
.loading-state,
.expired-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  gap: 24rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 16rpx;
}

.expired-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-top: 16rpx;
}

.expired-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  text-align: center;
  padding: 0 48rpx;
  line-height: 1.6;
}

.btn-back {
  margin-top: 32rpx;
  width: 240rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 40rpx;
  color: #fff;
  font-size: 28rpx;
  backdrop-filter: blur(10rpx);
}

.btn-back::after {
  border: none;
}

/* ===== 通用 glass-card ===== */
.glass-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  backdrop-filter: blur(20rpx);
}

/* ===== 头部账本信息 ===== */
.header-card {
  padding: 32rpx 24rpx;
}

.book-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.book-cover,
.book-cover-placeholder {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.book-cover-placeholder {
  background: linear-gradient(135deg, #e0f7fa 0%, #b2ebf2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.book-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
}

.book-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.book-member-count {
  font-size: 26rpx;
  color: #8091a5;
}

.member-avatars {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.member-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 3rpx solid #fff;
}

/* ===== 总览卡片 ===== */
.summary-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.summary-label {
  font-size: 28rpx;
  color: #5c6b7a;
}

.summary-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.summary-value.primary {
  font-size: 40rpx;
  color: #4097a9;
}

/* ===== 分组明细 ===== */
.groups-section {
  margin-top: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 20rpx;
  padding-left: 8rpx;
}

.group-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.group-item {
  display: flex;
  flex-direction: column;
  padding: 0;
  overflow: hidden;
}

.group-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx;
  transition: background 0.2s;
}

.group-header:active {
  background: rgba(64, 151, 169, 0.05);
}

.group-icon-area {
  flex-shrink: 0;
}

.group-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 3rpx solid #f0f0f0;
}

.group-icon-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #e8f5f7 0%, #d4ebf0 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.category-svg {
  width: 40rpx;
  height: 40rpx;
}

.group-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.group-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.group-sublabel {
  font-size: 24rpx;
  color: #8091a5;
}

.group-amount-area {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.group-amount {
  font-size: 34rpx;
  font-weight: 700;
  color: #4097a9;
}

/* ===== 账单明细 ===== */
.group-detail {
  padding: 0 24rpx 24rpx;
  border-top: 1rpx solid #f5f5f5;
}

.tx-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.tx-item:last-child {
  border-bottom: none;
}

.tx-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.tx-note {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 500;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.tx-amount {
  font-size: 32rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.tx-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #8091a5;
}

.tx-category {
  flex-shrink: 0;
}

.tx-dot {
  flex-shrink: 0;
}

.tx-date {
  flex-shrink: 0;
}

/* ===== 底部操作 ===== */
.footer-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  background: linear-gradient(to top, rgba(102, 126, 234, 0.95) 0%, rgba(102, 126, 234, 0) 100%);
  backdrop-filter: blur(10rpx);
  display: flex;
  gap: 16rpx;
}

.btn-save,
.btn-back-home {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.btn-save {
  background: rgba(255, 255, 255, 0.25);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  color: #fff;
}

.btn-save::after {
  border: none;
}

.btn-back-home {
  background: #fff;
  color: #667eea;
}

.btn-back-home::after {
  border: none;
}
