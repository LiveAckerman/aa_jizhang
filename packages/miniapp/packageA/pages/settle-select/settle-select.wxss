.select-page {
  min-height: 100vh;
  padding: 0 32rpx calc(140rpx + env(safe-area-inset-bottom));
}

/* 骨架屏 */
.sk-line,
.sk-all-bar,
.sk-circle,
.sk-icon {
  background: #eef0f2;
  animation: sk-blink 1.2s ease-in-out infinite;
}
@keyframes sk-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}
.sk-all-bar {
  width: 140rpx;
  height: 44rpx;
  border-radius: 10rpx;
  margin: 24rpx 8rpx;
}
.sk-group {
  margin-bottom: 8rpx;
}
.sk-line { border-radius: 8rpx; }
.sk-date { width: 160rpx; height: 24rpx; margin: 16rpx 0 12rpx 8rpx; }
.sk-list {
  padding: 8rpx 0;
}
.sk-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
}
.sk-circle {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  flex-shrink: 0;
}
.sk-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  flex-shrink: 0;
}
.sk-mid {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.sk-cat { width: 120rpx; height: 26rpx; }
.sk-note { width: 220rpx; height: 22rpx; }
.sk-amt { width: 100rpx; height: 30rpx; flex-shrink: 0; }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 180rpx;
  gap: 16rpx;
}
.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-top: 16rpx;
}
.empty-sub {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 工具栏：全选 + 搜索 */
.toolbar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
}

/* 全选栏 */
.select-all-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  flex-shrink: 0;
  padding: 8rpx 4rpx;
}

/* 搜索框 */
.search-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 64rpx;
  padding: 0 24rpx;
  background: #fff;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(47, 65, 89, 0.06);
}
.search-input {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--text-primary);
}
.search-input-ph {
  color: #8091a5;
}

/* 搜索无结果 */
.search-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding-top: 120rpx;
}
.search-empty-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 账单分组 */
.tx-date {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin: 16rpx 0 12rpx 8rpx;
}

.glass-card {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(47, 65, 89, 0.05);
  margin-bottom: 20rpx;
}

.tx-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid rgba(128, 145, 165, 0.08);
}
.tx-item:last-child {
  border-bottom: none;
}
.tx-item.checked {
  background: rgba(64, 151, 169, 0.05);
}

.tx-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background: rgba(64, 151, 169, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
/* 自定义 SVG 分类图标（饮品），尺寸对齐 van-icon 20px */
.tx-icon-svg {
  width: 40rpx;
  height: 40rpx;
}

.tx-mid {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.tx-cat {
  font-size: 28rpx;
  color: var(--text-primary);
}
.tx-note {
  font-size: 22rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tx-amount {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-accent);
}

/* 底部确认栏 */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(40rpx);
  box-shadow: 0 -4rpx 24rpx rgba(47, 65, 89, 0.07);
}
.footer-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.footer-count {
  font-size: 24rpx;
  color: var(--text-secondary);
}
.footer-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-accent);
}
.btn-preview {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 48rpx;
  border-radius: 40rpx;
  background: var(--color-primary) !important;
  color: #fff !important;
  font-size: 28rpx;
  font-weight: 600;
  border: none !important;
}
.btn-preview[disabled] {
  opacity: 0.5;
  background: var(--color-primary) !important;
}
.btn-preview::after {
  border: none;
}
